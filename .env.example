# Generated by `mix gamend.settings.env_example` — do not edit by hand.
#
# Every variable below is declared with GameServer.Settings.Provider, which
# is also what the admin Settings page renders. Values shown are defaults;
# a commented line means the default applies when the variable is unset.
#
# Every name is derived from its declaration as GAMEND_<GROUP>_<KEY>, with
# no exceptions. Variables other software reads (RELEASE_COOKIE for the
# release boot script, FLY_* from the platform) are not settings and are
# not listed here.
#
# Settings can equally be configured in Elixir, which skips this file
# entirely:
#
#     config :game_server_core, GameServer.Retention, chat_messages_days: 90

# ──────────────────────────────────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────────────────────────────────

# Allow POST /api/v1/login/device. When on, any unknown device_id creates an
# anonymous account.
# GAMEND_AUTH_DEVICE_AUTH_ENABLED=true

# JWT signing key. Defaults to secret_key_base when unset.
# Secret — never commit a real value.
# GAMEND_AUTH_GUARDIAN_SECRET_KEY=

# Minimum password length enforced at registration and change.
# GAMEND_AUTH_MIN_PASSWORD_LENGTH=8

# New accounts cannot log in until an admin activates them (beta mode).
# GAMEND_AUTH_REQUIRE_ACTIVATION=false

# Signs and encrypts cookies, tokens and LiveView sessions.
# REQUIRED in production — the server refuses to start without it.
# Secret — never commit a real value.
# GAMEND_AUTH_SECRET_KEY_BASE=

# ──────────────────────────────────────────────────────────────────────────
# Cache
# ──────────────────────────────────────────────────────────────────────────

# Set false to bypass caching entirely.
# GAMEND_CACHE_ENABLED=true

# redis or partitioned. Only used when mode is multi; partitioned needs
# clustering.
# GAMEND_CACHE_L2=partitioned

# single (L1 local only) or multi (L1 + a shared L2).
# GAMEND_CACHE_MODE=single

# GAMEND_CACHE_REDIS_POOL_SIZE=10

# Redis URL for the shared L2.
# REQUIRED in production — the server refuses to start without it, when cache.mode is :multi and cache.l2 is :redis.
# GAMEND_CACHE_REDIS_URL=

# ──────────────────────────────────────────────────────────────────────────
# Clustering
# ──────────────────────────────────────────────────────────────────────────

# DNS name whose A/AAAA records list the other nodes, polled at boot.
# GAMEND_CLUSTER_DNS_QUERY=

# Shared fallback URL used by the cache and rate limiter when neither sets
# its own.
# GAMEND_CLUSTER_REDIS_URL=

# ──────────────────────────────────────────────────────────────────────────
# Content & plugins
# ──────────────────────────────────────────────────────────────────────────

# Version reported in the OpenAPI spec and admin pages.
# GAMEND_CONTENT_APP_VERSION=

# MaxMind mmdb file. Defaults to data/GeoLite2-Country.mmdb when present.
# GAMEND_CONTENT_GEOIP_DB_PATH=

# Directory containing OTP hook plugins.
# GAMEND_CONTENT_PLUGINS_DIR=modules/plugins

# Path to the theme JSON. A single file serves every locale; its text is
# translated via the gettext `theme` domain.
# GAMEND_CONTENT_THEME_CONFIG=

# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────

# sqlite or postgres. Compile-time; set as a build arg, not at boot.
# GAMEND_DB_ADAPTER=sqlite

# Connect over IPv6, needed on platforms with IPv6-only private networking.
# GAMEND_DB_IPV6=false

# Connections in the pool. Defaults to 10 on Postgres, 5 on SQLite.
# GAMEND_DB_POOL_SIZE=

# How long a request waits to check out a connection, in milliseconds.
# GAMEND_DB_POOL_TIMEOUT_MS=10000

# GAMEND_DB_POSTGRES_DB=

# GAMEND_DB_POSTGRES_HOST=

# Secret — never commit a real value.
# GAMEND_DB_POSTGRES_PASSWORD=

# GAMEND_DB_POSTGRES_PORT=5432

# GAMEND_DB_POSTGRES_USER=

# GAMEND_DB_QUERY_TIMEOUT_MS=15000

# GAMEND_DB_QUEUE_INTERVAL_MS=1000

# GAMEND_DB_QUEUE_TARGET=10000

# Wait this long for a lock instead of failing with "database is locked".
# GAMEND_DB_SQLITE_BUSY_TIMEOUT_MS=15000

# GAMEND_DB_SQLITE_CACHE_SIZE_KB=200000

# Where the SQLite file lives. Point at a mounted volume in production.
# GAMEND_DB_SQLITE_PATH=

# off | normal | full | extra. Lower means fewer fsyncs and less durability.
# GAMEND_DB_SQLITE_SYNCHRONOUS=normal

# GAMEND_DB_SQLITE_WAL_AUTOCHECKPOINT=2000

# Full ecto:// URL. Takes precedence over the individual postgres_* values.
# Secret — never commit a real value.
# GAMEND_DB_URL=

# ──────────────────────────────────────────────────────────────────────────
# Email
# ──────────────────────────────────────────────────────────────────────────

# GAMEND_MAIL_SMTP_FROM_EMAIL=

# GAMEND_MAIL_SMTP_FROM_NAME=Game Server

# SMTP password, or the provider's API key.
# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# Secret — never commit a real value.
# GAMEND_MAIL_SMTP_PASSWORD=

# GAMEND_MAIL_SMTP_PORT=465

# SMTP host, e.g. smtp.resend.com.
# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# GAMEND_MAIL_SMTP_RELAY=

# TLS server name indication. Defaults to the relay host.
# GAMEND_MAIL_SMTP_SNI=

# GAMEND_MAIL_SMTP_SSL=true

# STARTTLS policy: never | if_available | always.
# GAMEND_MAIL_SMTP_TLS=never

# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# GAMEND_MAIL_SMTP_USERNAME=

# ──────────────────────────────────────────────────────────────────────────
# Limits
# ──────────────────────────────────────────────────────────────────────────

# Grace before an offline player's ticket is pruned; long enough that a
# brief disconnect keeps its queue position.
# GAMEND_LIMITS_MATCHMAKING_OFFLINE_GRACE_MS=300000

# Sweep interval of the matchmaking worker.
# GAMEND_LIMITS_MATCHMAKING_TICK_MS=3000

# How long the oldest ticket waits before a below-max group still forms.
# GAMEND_LIMITS_MATCHMAKING_TIMEOUT_MS=30000

# Progress rows a user may hold in the current periods; excess events are
# ignored.
# GAMEND_LIMITS_MAX_ACTIVE_QUESTS_PER_USER=200

# GAMEND_LIMITS_MAX_CHAT_CONTENT=4096

# Rolling 24h; 0 disables. Needs rate limiting on; ETS backend counts per
# instance.
# GAMEND_LIMITS_MAX_CHAT_MESSAGES_PER_DAY=5000

# GAMEND_LIMITS_MAX_DEVICE_ID=256

# GAMEND_LIMITS_MAX_DISPLAY_NAME=80

# GAMEND_LIMITS_MAX_EMAIL=160

# GAMEND_LIMITS_MAX_FRIENDS_PER_USER=500

# GAMEND_LIMITS_MAX_GROUP_DESCRIPTION=500

# GAMEND_LIMITS_MAX_GROUP_MEMBERS=10000

# GAMEND_LIMITS_MAX_GROUP_PENDING_INVITES=100

# GAMEND_LIMITS_MAX_GROUP_TITLE=80

# GAMEND_LIMITS_MAX_GROUPS_CREATED_PER_USER=20

# GAMEND_LIMITS_MAX_GROUPS_PER_USER=50

# GAMEND_LIMITS_MAX_HOOK_ARGS_COUNT=32

# GAMEND_LIMITS_MAX_HOOK_ARGS_SIZE=65536

# GAMEND_LIMITS_MAX_KV_ENTRIES_PER_USER=1000

# GAMEND_LIMITS_MAX_KV_KEY=512

# GAMEND_LIMITS_MAX_KV_VALUE_SIZE=65536

# GAMEND_LIMITS_MAX_LEADERBOARD_DESCRIPTION=1000

# GAMEND_LIMITS_MAX_LEADERBOARD_SLUG=100

# GAMEND_LIMITS_MAX_LEADERBOARD_TITLE=255

# GAMEND_LIMITS_MAX_LOBBY_PASSWORD=128

# GAMEND_LIMITS_MAX_LOBBY_TITLE=80

# GAMEND_LIMITS_MAX_LOBBY_USERS=128

# Serialized byte size of a ticket's match_params map.
# GAMEND_LIMITS_MAX_MATCHMAKING_PARAMS_SIZE=2048

# Hard cap on a ticket's own max_players setting.
# GAMEND_LIMITS_MAX_MATCHMAKING_PLAYERS=64

# GAMEND_LIMITS_MAX_METADATA_SIZE=16384

# GAMEND_LIMITS_MAX_NOTIFICATION_CONTENT=10000

# GAMEND_LIMITS_MAX_NOTIFICATION_TITLE=255

# GAMEND_LIMITS_MAX_NOTIFICATIONS_PER_USER=500

# GAMEND_LIMITS_MAX_OBJECTIVES_PER_QUEST=10

# GAMEND_LIMITS_MAX_PAGE_SIZE=100

# GAMEND_LIMITS_MAX_PARTY_PENDING_INVITES=20

# GAMEND_LIMITS_MAX_PARTY_SIZE=32

# GAMEND_LIMITS_MAX_PENDING_FRIEND_REQUESTS=100

# GAMEND_LIMITS_MAX_PROFILE_URL=512

# GAMEND_LIMITS_MAX_PUSH_BODY=4000

# Serialized byte size of a push message's custom data map.
# GAMEND_LIMITS_MAX_PUSH_DATA_SIZE=4096

# GAMEND_LIMITS_MAX_PUSH_TITLE=255

# Live (non-disabled) device tokens per user.
# GAMEND_LIMITS_MAX_PUSH_TOKENS_PER_USER=20

# GAMEND_LIMITS_MAX_QUEST_CATEGORY=64

# GAMEND_LIMITS_MAX_QUEST_DESCRIPTION=1000

# GAMEND_LIMITS_MAX_QUEST_KEY=100

# Days of daily/weekly period history kept before the retention prune.
# GAMEND_LIMITS_MAX_QUEST_PERIOD_HISTORY=90

# GAMEND_LIMITS_MAX_QUEST_REWARD_ENTRIES=10

# GAMEND_LIMITS_MAX_QUEST_TITLE=255

# GAMEND_LIMITS_MAX_QUESTS=500

# Hard cap on participants in one check.
# GAMEND_LIMITS_MAX_READY_CHECK_PARTICIPANTS=64

# Concurrent sockets per user. 0 disables; counted per app instance.
# GAMEND_LIMITS_MAX_SOCKETS_PER_USER=20

# GAMEND_LIMITS_MAX_TOURNAMENT_BRACKET_SIZE=256

# GAMEND_LIMITS_MAX_TOURNAMENT_DESCRIPTION=1000

# Hard cap on a tournament's own max_entries setting.
# GAMEND_LIMITS_MAX_TOURNAMENT_ENTRIES=10000

# GAMEND_LIMITS_MAX_TOURNAMENT_SLUG=100

# GAMEND_LIMITS_MAX_TOURNAMENT_TITLE=255

# Max size of a single uploaded object (avatars/UGC). 5 MiB.
# GAMEND_LIMITS_MAX_UPLOAD_BYTES=5242880

# GAMEND_LIMITS_MAX_USERNAME=32

# GAMEND_LIMITS_MIN_USERNAME=3

# Default answering window. Overridable per check by the caller.
# GAMEND_LIMITS_READY_CHECK_TIMEOUT_MS=15000

# ──────────────────────────────────────────────────────────────────────────
# Lobby snapshots
# ──────────────────────────────────────────────────────────────────────────

# Record a durable per-run snapshot of lobby state, browsable at
# /admin/lobby_snapshots.
# GAMEND_LOBBY_SNAPSHOTS_ENABLED=false

# Cap on KV entries captured per snapshot.
# GAMEND_LOBBY_SNAPSHOTS_MAX_KV_ENTRIES=200

# User-scoped KV keys to capture. Empty captures none — the widest exposure
# in a snapshot.
# GAMEND_LOBBY_SNAPSHOTS_USER_KV_KEYS=

# ──────────────────────────────────────────────────────────────────────────
# OAuth providers
# ──────────────────────────────────────────────────────────────────────────

# Services id (web audience) for Sign in with Apple.
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_CLIENT_ID=

# Bundle id (iOS audience) used when verifying Apple ID tokens.
# GAMEND_OAUTH_APPLE_IOS_CLIENT_ID=

# Key id of the Sign in with Apple auth key (Apple Developer -> Keys).
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_KEY_ID=

# Contents of the Sign in with Apple .p8 key.
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_APPLE_PRIVATE_KEY=

# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_TEAM_ID=

# Expected in production — logs a warning when missing, if any of discord_client_secret is set.
# GAMEND_OAUTH_DISCORD_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of discord_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_DISCORD_CLIENT_SECRET=

# Expected in production — logs a warning when missing, if any of facebook_client_secret is set.
# GAMEND_OAUTH_FACEBOOK_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of facebook_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_FACEBOOK_CLIENT_SECRET=

# Expected in production — logs a warning when missing, if any of google_client_secret is set.
# GAMEND_OAUTH_GOOGLE_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of google_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_GOOGLE_CLIENT_SECRET=

# Native-app client id used to verify Google ID tokens from SDK sign-in.
# GAMEND_OAUTH_GOOGLE_WEB_CLIENT_ID=

# Steam Web API key, used for OpenID sign-in.
# Secret — never commit a real value.
# GAMEND_OAUTH_STEAM_API_KEY=

# GAMEND_OAUTH_STEAM_APP_ID=

# ──────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────

# Level for per-request access logs, or `off` to silence them.
# GAMEND_OBSERVABILITY_ACCESS_LOG_LEVEL=debug

# Public Grafana URL linked from the admin dashboard, if you host one.
# GAMEND_OBSERVABILITY_GRAFANA_URL=

# Level for the rotating file handler.
# GAMEND_OBSERVABILITY_LOG_FILE_LEVEL=info

# Bytes per rotated file.
# GAMEND_OBSERVABILITY_LOG_FILE_MAX_BYTES=10000000

# How many rotated files to keep. With the default size, ~50MB of disk.
# GAMEND_OBSERVABILITY_LOG_FILE_MAX_FILES=5

# Write a rotating log file alongside stdout. Unset disables the file
# handler.
# GAMEND_OBSERVABILITY_LOG_FILE_PATH=

# Application log level: debug | info | warning | error.
# GAMEND_OBSERVABILITY_LOG_LEVEL=info

# When set, every non-loopback /metrics scrape must send `Authorization:
# Bearer <token>`.
# Secret — never commit a real value.
# GAMEND_OBSERVABILITY_METRICS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Payments
# ──────────────────────────────────────────────────────────────────────────

# GAMEND_PAYMENTS_APPLE_APP_STORE_SERVER_BASE_URL=

# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# GAMEND_PAYMENTS_APPLE_BUNDLE_ID=

# Issuer id from App Store Connect -> Users and Access -> Integrations.
# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_APPLE_ISSUER_ID=

# Key id of the App Store Connect API key — not the Sign in with Apple key.
# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# GAMEND_PAYMENTS_APPLE_KEY_ID=

# Inline .p8 contents for the App Store Connect API key.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_APPLE_PRIVATE_KEY=

# GAMEND_PAYMENTS_APPLE_PRIVATE_KEY_PATH=

# sandbox while validating, production for real transactions.
# GAMEND_PAYMENTS_ENVIRONMENT=production

# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_ACCESS_TOKEN=

# GAMEND_PAYMENTS_GOOGLE_PLAY_AUTO_ACKNOWLEDGE=false

# Expected in production — logs a warning when missing, if any of google_play_package_name/google_play_service_account_json is set.
# GAMEND_PAYMENTS_GOOGLE_PLAY_PACKAGE_NAME=

# GAMEND_PAYMENTS_GOOGLE_PLAY_PUBLISHER_BASE_URL=

# Shared bearer token on the Pub/Sub push webhook. Without it the RTDN
# endpoint fails closed in production.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_RTDN_TOKEN=

# Inline service-account JSON. Use the _PATH variant to read it from a file
# instead.
# Expected in production — logs a warning when missing, if any of google_play_package_name/google_play_service_account_json is set.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# GAMEND_PAYMENTS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=

# GAMEND_PAYMENTS_STEAM_APP_ID=

# GAMEND_PAYMENTS_STEAM_MICROTXN_BASE_URL=

# Falls back to the OAuth Steam key when unset.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STEAM_WEB_API_KEY=

# GAMEND_PAYMENTS_STRIPE_API_VERSION=2022-11-15

# sk_live_... key, used when environment is production.
# Expected in production — logs a warning when missing, when payments.environment is :production.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_PRODUCTION_SECRET_KEY=

# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_PRODUCTION_WEBHOOK_SECRET=

# sk_test_... key, used when environment is sandbox.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_SANDBOX_SECRET_KEY=

# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_SANDBOX_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Public features
# ──────────────────────────────────────────────────────────────────────────

# GET /api/v1/groups*, the "groups" channel and the /groups pages.
# GAMEND_FEATURES_LIST_GROUPS=true

# Public GET/resolve /api/v1/leaderboards* and the /leaderboards pages.
# GAMEND_FEATURES_LIST_LEADERBOARDS=true

# GET /api/v1/lobbies and the "lobbies" channel.
# GAMEND_FEATURES_LIST_LOBBIES=true

# GET /api/v1/matchmaking/stats. Own-ticket endpoints stay.
# GAMEND_FEATURES_LIST_MATCHMAKING=true

# Public GET /api/v1/quests* and the /quests page.
# GAMEND_FEATURES_LIST_QUESTS=true

# GET /api/v1/users and /users/:id.
# GAMEND_FEATURES_LIST_USERS=true

# Serve the in-browser mailbox at /dev/mailbox outside dev. Every sent email
# is readable there.
# GAMEND_FEATURES_MAILBOX_PREVIEW=false

# OpenAPI spec + Swagger UI. A complete map of your API — consider off in
# production.
# GAMEND_FEATURES_OPENAPI=true

# ──────────────────────────────────────────────────────────────────────────
# Push notifications
# ──────────────────────────────────────────────────────────────────────────

# Set to `log` to route every delivery to the Log provider, credentials or
# not.
# GAMEND_PUSH_ADAPTER=auto

# `production`, or `sandbox` for dev builds.
# GAMEND_PUSH_APNS_ENV=production

# 10-character key id of the APNs auth key.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_KEY_ID=

# APNs .p8 key contents, or a path to the file.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# Secret — never commit a real value.
# GAMEND_PUSH_APNS_PRIVATE_KEY=

# Apple developer team id.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_TEAM_ID=

# App bundle id, sent as apns-topic.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_TOPIC=

# FCM service-account JSON, inline or a path to the file.
# Secret — never commit a real value.
# GAMEND_PUSH_FCM_CREDENTIALS=

# Defaults to the project id inside the FCM credentials.
# GAMEND_PUSH_FCM_PROJECT_ID=

# Per-node concurrent deliveries on the push queue.
# GAMEND_PUSH_QUEUE_CONCURRENCY=10

# ──────────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────────

# Max login/register requests per window, per IP.
# GAMEND_RATELIMIT_AUTH_LIMIT=10

# Auth HTTP window, in milliseconds.
# GAMEND_RATELIMIT_AUTH_WINDOW_MS=60000

# ets (per-node counters) or redis (shared across instances).
# GAMEND_RATELIMIT_BACKEND=ets

# Max WebRTC DataChannel messages per window, per user.
# GAMEND_RATELIMIT_DC_LIMIT=300

# WebRTC DataChannel window, in milliseconds.
# GAMEND_RATELIMIT_DC_WINDOW_MS=10000

# Master switch for all request/message throttling.
# GAMEND_RATELIMIT_ENABLED=true

# Max general HTTP requests per window, per IP.
# GAMEND_RATELIMIT_GENERAL_LIMIT=240

# General HTTP window, in milliseconds.
# GAMEND_RATELIMIT_GENERAL_WINDOW_MS=60000

# Max ICE candidate messages per window, per user.
# GAMEND_RATELIMIT_ICE_LIMIT=150

# ICE candidate window, in milliseconds.
# GAMEND_RATELIMIT_ICE_WINDOW_MS=30000

# Redis URL for shared counters.
# REQUIRED in production — the server refuses to start without it, when ratelimit.backend is :redis.
# GAMEND_RATELIMIT_REDIS_URL=

# Max WebSocket channel messages per window, per user.
# GAMEND_RATELIMIT_WS_LIMIT=60

# WebSocket window, in milliseconds.
# GAMEND_RATELIMIT_WS_WINDOW_MS=10000

# ──────────────────────────────────────────────────────────────────────────
# Realtime
# ──────────────────────────────────────────────────────────────────────────

# Hold outbound state updates this long and push only the latest per object.
# 0 pushes immediately.
# GAMEND_REALTIME_DEBOUNCE_MS=0

# ──────────────────────────────────────────────────────────────────────────
# Retention
# ──────────────────────────────────────────────────────────────────────────

# Delete lobbies nobody has been seen in for N minutes. 0 disables.
# GAMEND_RETENTION_ABANDONED_LOBBY_MINUTES=15

# Delete chat messages older than N days. 0 keeps forever.
# GAMEND_RETENTION_CHAT_MESSAGES_DAYS=0

# Delete resolved invites and join requests N days after resolution.
# GAMEND_RETENTION_INVITES_DAYS=30

# Delete wallet/inventory ledger entries older than N days. 0 keeps forever.
# GAMEND_RETENTION_LEDGER_DAYS=0

# Delete lobby snapshots, events and blobs older than N days.
# GAMEND_RETENTION_LOBBY_SNAPSHOTS_DAYS=30

# Longer window for snapshots of runs flagged anomalous.
# GAMEND_RETENTION_LOBBY_SNAPSHOTS_FLAGGED_DAYS=90

# Delete matchmaking tickets older than N hours, in any status.
# GAMEND_RETENTION_MATCHMAKING_TICKETS_HOURS=24

# Delete notifications older than N days. 0 keeps forever.
# GAMEND_RETENTION_NOTIFICATIONS_DAYS=0

# Delete payment provider webhook events older than N days. Purchases are
# never pruned.
# GAMEND_RETENTION_PAYMENT_EVENTS_DAYS=0

# Delete push tokens untouched for N days. Defaults to Google's stale-token
# guidance.
# GAMEND_RETENTION_PUSH_TOKENS_DAYS=270

# Delete finished tournaments older than N days. 0 keeps forever.
# GAMEND_RETENTION_TOURNAMENTS_DAYS=0

# ──────────────────────────────────────────────────────────────────────────
# Server & HTTP
# ──────────────────────────────────────────────────────────────────────────

# Browser CORS/WebSocket origin allowlist. Empty allows any origin. Prefix
# an entry with `regex:` for a pattern.
# GAMEND_HTTP_ALLOWED_ORIGINS=

# Public hostname, used to build URLs and OAuth redirect URIs.
# GAMEND_HTTP_HOST=localhost

# TCP port the HTTP listener binds.
# GAMEND_HTTP_PORT=4000

# http or https. Defaults to http for localhost, https otherwise.
# GAMEND_HTTP_SCHEME=

# Start the HTTP listener. Only needed when running as a release.
# GAMEND_HTTP_SERVER=false

# ──────────────────────────────────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────────────────────────────────

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# Secret — never commit a real value.
# GAMEND_STORAGE_ACCESS_KEY_ID=

# Backend for avatars and uploads: local | s3 (any S3-compatible service).
# GAMEND_STORAGE_ADAPTER=local

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# GAMEND_STORAGE_BUCKET=

# Directory the local adapter writes objects to.
# GAMEND_STORAGE_DIR=priv/storage

# Custom endpoint, e.g. https://<account>.r2.cloudflarestorage.com.
# GAMEND_STORAGE_ENDPOINT=

# CDN or base URL serving stored objects, whichever backend is behind it.
# GAMEND_STORAGE_PUBLIC_URL=

# Region, or "auto" for services that do not use one (R2, MinIO).
# GAMEND_STORAGE_REGION=auto

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# Secret — never commit a real value.
# GAMEND_STORAGE_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────────────────────────────────
# TLS & certificates
# ──────────────────────────────────────────────────────────────────────────

# Webroot for Let's Encrypt HTTP-01 challenge files. Defaults to
# /var/www/acme.
# GAMEND_TLS_ACME_WEBROOT=

# Path to fullchain.pem (certificate + CA chain).
# Expected in production — logs a warning when missing, if any of certfile/keyfile is set.
# GAMEND_TLS_CERTFILE=

# Redirect HTTP to HTTPS and send HSTS. Defaults to on once certs are
# readable.
# GAMEND_TLS_FORCE=

# Path to privkey.pem.
# Expected in production — logs a warning when missing, if any of certfile/keyfile is set.
# GAMEND_TLS_KEYFILE=

# HTTPS listen port.
# GAMEND_TLS_PORT=443
