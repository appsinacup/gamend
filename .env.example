# Generated by `mix gamend.settings.env_example` — do not edit by hand.
#
# Every variable below is declared with Gamend.Settings.Provider, which
# is also what the admin Settings page renders. Values shown are defaults;
# a commented line means the default applies when the variable is unset.
#
# Every name is derived from its declaration as GAMEND_<GROUP>_<KEY>, with
# no exceptions. Variables other software reads (RELEASE_COOKIE for the
# release boot script, FLY_* from the platform) are not settings and are
# not listed here.
#
# Settings can equally be configured in Elixir, which skips this file
# entirely:
#
#     config :gamend_core, Gamend.Retention, chat_messages_days: 90

# ──────────────────────────────────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────────────────────────────────

# Lifetime of API access tokens, in minutes. Login and refresh answer it as
# expires_in. Applies to tokens issued after the change.
# GAMEND_AUTH_ACCESS_TOKEN_TTL_MINUTES=15

# Allow device-only accounts to upload an avatar. Off by default: an
# anonymous account costs one request to create, so this is the cheapest way
# for a bot to burn object storage.
# GAMEND_AUTH_ANONYMOUS_CAN_UPLOAD_AVATAR=false

# Longest lifetime a personal API token may have, in days. Applies to
# existing tokens too, counted from creation. 0 allows tokens that never
# expire.
# GAMEND_AUTH_API_TOKEN_MAX_DAYS=0

# Argon2id memory per hash, as a power of two in KiB — 14 is 16 MiB. Peak
# use is this times the vCPU count, not times the request rate, because the
# BEAM runs at most one hash per dirty CPU scheduler. Below 12 (4 MiB) it
# stops being meaningfully memory-hard.
# GAMEND_AUTH_ARGON2_MEMORY_LOG2=14

# Argon2id passes over memory. Raise to compensate when lowering memory.
# GAMEND_AUTH_ARGON2_TIME_COST=3

# How long the link confirming a new email address stays valid, in days.
# GAMEND_AUTH_CHANGE_EMAIL_DAYS=7

# How long an email confirmation link stays valid, in days.
# GAMEND_AUTH_CONFIRM_EMAIL_DAYS=7

# Days between a player deleting their own account and it being deleted.
# Signing in on the website within that time keeps the account. 0 deletes at
# once.
# GAMEND_AUTH_DELETION_GRACE_DAYS=0

# Allow POST /api/v1/login/device. When on, any unknown device_id creates an
# anonymous account.
# GAMEND_AUTH_DEVICE_AUTH_ENABLED=true

# JWT signing key. Defaults to secret_key_base when unset.
# Secret — never commit a real value.
# GAMEND_AUTH_GUARDIAN_SECRET_KEY=

# Failed passwords for one email address that lock its password sign-in.
# Counted per address across every IP. 0 disables the lockout.
# GAMEND_AUTH_LOCKOUT_ATTEMPTS=10

# How long a lock lasts. Emailed login links and provider sign-in still work
# meanwhile, so the owner is never shut out.
# GAMEND_AUTH_LOCKOUT_MINUTES=15

# The failures must fall within this many minutes to lock.
# GAMEND_AUTH_LOCKOUT_WINDOW_MINUTES=15

# How long an emailed login link stays valid, in minutes. Capped at 60:
# anyone who can read the email can sign in while the link lives.
# GAMEND_AUTH_MAGIC_LINK_MINUTES=15

# Minimum password length enforced at registration and change.
# GAMEND_AUTH_MIN_PASSWORD_LENGTH=8

# Lifetime of API refresh tokens, in days. A refresh keeps its token, so
# this is how long a client stays signed in without logging in again.
# GAMEND_AUTH_REFRESH_TOKEN_TTL_DAYS=30

# New accounts cannot log in until an admin activates them (beta mode).
# GAMEND_AUTH_REQUIRE_ACTIVATION=false

# Signs and encrypts cookies, tokens and LiveView sessions.
# REQUIRED in production — the server refuses to start without it.
# Secret — never commit a real value.
# GAMEND_AUTH_SECRET_KEY_BASE=

# Lifetime of a browser session and its remember-me cookie, in days. An
# active session is renewed once it is half this old.
# GAMEND_AUTH_SESSION_DAYS=14

# How recently a user must have signed in to open the settings that change
# their password or email. Submitting the form is allowed 10 minutes more.
# GAMEND_AUTH_SUDO_MODE_MINUTES=10

# ──────────────────────────────────────────────────────────────────────────
# Background jobs
# ──────────────────────────────────────────────────────────────────────────

# Days finished, cancelled and discarded jobs are kept before they are
# deleted.
# GAMEND_JOBS_PRUNE_AFTER_DAYS=7

# Per-node concurrent jobs on the default queue.
# GAMEND_JOBS_QUEUE_DEFAULT=10

# Per-node concurrent jobs on the hooks queue: enqueued and scheduled plugin
# hooks.
# GAMEND_JOBS_QUEUE_HOOKS=20

# Per-node concurrent email sends.
# GAMEND_JOBS_QUEUE_MAILERS=5

# Per-node concurrent storage jobs, such as avatar mirroring.
# GAMEND_JOBS_QUEUE_STORAGE=5

# Per-node concurrent outgoing webhook deliveries.
# GAMEND_JOBS_QUEUE_WEBHOOKS=10

# ──────────────────────────────────────────────────────────────────────────
# Cache
# ──────────────────────────────────────────────────────────────────────────

# Set false to bypass caching entirely.
# GAMEND_CACHE_ENABLED=true

# redis or partitioned. Only used when mode is multi; partitioned needs
# clustering.
# GAMEND_CACHE_L2=partitioned

# Most entries each node's local cache holds.
# GAMEND_CACHE_MAX_ENTRIES=1000000

# Most memory each node's local cache may use, in MB. Lower it on a small
# machine: the default alone is most of a 512 MB instance.
# GAMEND_CACHE_MAX_MEMORY_MB=500

# single (L1 local only) or multi (L1 + a shared L2).
# GAMEND_CACHE_MODE=single

# GAMEND_CACHE_REDIS_POOL_SIZE=10

# Redis URL for the shared L2.
# REQUIRED in production — the server refuses to start without it, when cache.mode is :multi and cache.l2 is :redis.
# GAMEND_CACHE_REDIS_URL=

# How long a cached entity (user, lobby, party, group, KV entry...) is kept,
# in ms. On a cluster it bounds how stale a node can be when an invalidation
# is missed.
# GAMEND_CACHE_TTL_MS=60000

# ──────────────────────────────────────────────────────────────────────────
# Captcha
# ──────────────────────────────────────────────────────────────────────────

# Also require a captcha token (`captcha_token`) on POST /api/v1/register.
# Needs `enabled`; a client that cannot render the widget cannot register.
# GAMEND_CAPTCHA_API_REGISTER=false

# Require a captcha on the register and magic-link forms.
# GAMEND_CAPTCHA_ENABLED=false

# Turnstile secret key, for server-side verification.
# REQUIRED in production — the server refuses to start without it, when captcha.enabled is true.
# Secret — never commit a real value.
# GAMEND_CAPTCHA_SECRET_KEY=

# Turnstile sitekey (public, rendered into the page).
# Expected in production — logs a warning when missing, when captcha.enabled is true.
# GAMEND_CAPTCHA_SITE_KEY=

# How long to wait for Cloudflare before giving up on a verification.
# GAMEND_CAPTCHA_TIMEOUT_MS=5000

# ──────────────────────────────────────────────────────────────────────────
# Client logs
# ──────────────────────────────────────────────────────────────────────────

# Per-category level overrides as category:level pairs, e.g.
# perf:off,network:warn. Overrides the floor for that category only; off
# drops it entirely.
# GAMEND_CLIENT_LOGS_CATEGORY_LEVELS=

# Accept log batches from game clients and re-emit them into the server's
# own logs, indexed at /admin/logs.
# GAMEND_CLIENT_LOGS_ENABLED=false

# Lowest client level to collect: trace, debug, info, warn or error. Clients
# gate their own uploads on this.
# GAMEND_CLIENT_LOGS_LEVEL=info

# Delete client sessions after N days of inactivity. 0 keeps them forever.
# GAMEND_CLIENT_LOGS_RETENTION_DAYS=14

# Retention for sessions marked flagged (any session that logged an error).
# GAMEND_CLIENT_LOGS_RETENTION_FLAGGED_DAYS=90

# ──────────────────────────────────────────────────────────────────────────
# Clustering
# ──────────────────────────────────────────────────────────────────────────

# DNS name whose A/AAAA records list the other nodes, polled at boot.
# GAMEND_CLUSTER_DNS_QUERY=

# Shared fallback URL used by the cache and rate limiter when neither sets
# its own.
# GAMEND_CLUSTER_REDIS_URL=

# ──────────────────────────────────────────────────────────────────────────
# Content & plugins
# ──────────────────────────────────────────────────────────────────────────

# Version reported in the OpenAPI spec and admin pages.
# GAMEND_CONTENT_APP_VERSION=

# MaxMind mmdb file. Defaults to data/GeoLite2-Country.mmdb when present.
# GAMEND_CONTENT_GEOIP_DB_PATH=

# Directory containing OTP hook plugins.
# GAMEND_CONTENT_PLUGINS_DIR=modules/plugins

# Path to the theme JSON. A single file serves every locale; its text is
# translated via the gettext `theme` domain.
# GAMEND_CONTENT_THEME_CONFIG=

# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────

# sqlite or postgres. Compile-time; set as a build arg, not at boot.
# GAMEND_DB_ADAPTER=sqlite

# Connect over IPv6, needed on platforms with IPv6-only private networking.
# GAMEND_DB_IPV6=false

# Connections in the pool. Defaults to 10 on Postgres, 1 on SQLite.
# GAMEND_DB_POOL_SIZE=

# How long a request waits to check out a connection, in milliseconds.
# GAMEND_DB_POOL_TIMEOUT_MS=10000

# GAMEND_DB_POSTGRES_DB=

# GAMEND_DB_POSTGRES_HOST=

# Secret — never commit a real value.
# GAMEND_DB_POSTGRES_PASSWORD=

# GAMEND_DB_POSTGRES_PORT=5432

# on | off | local | remote_write | remote_apply. Defaults to `off`: up to
# ~600ms of commits are exposed to an OS crash in exchange for markedly
# faster writes. Payments always commit synchronously regardless. Postgres
# only.
# GAMEND_DB_POSTGRES_SYNCHRONOUS_COMMIT=off

# GAMEND_DB_POSTGRES_USER=

# GAMEND_DB_QUERY_TIMEOUT_MS=15000

# GAMEND_DB_QUEUE_INTERVAL_MS=1000

# GAMEND_DB_QUEUE_TARGET=10000

# Wait this long for a lock instead of failing with "database is locked".
# GAMEND_DB_SQLITE_BUSY_TIMEOUT_MS=15000

# GAMEND_DB_SQLITE_CACHE_SIZE_KB=200000

# Where the SQLite file lives. Point at a mounted volume in production.
# GAMEND_DB_SQLITE_PATH=

# off | normal | full | extra. Lower means fewer fsyncs and less durability.
# GAMEND_DB_SQLITE_SYNCHRONOUS=normal

# GAMEND_DB_SQLITE_WAL_AUTOCHECKPOINT=2000

# Full ecto:// URL. Takes precedence over the individual postgres_* values.
# Secret — never commit a real value.
# GAMEND_DB_URL=

# ──────────────────────────────────────────────────────────────────────────
# Email
# ──────────────────────────────────────────────────────────────────────────

# Longest one email send may take before it is abandoned. gen_smtp itself
# waits up to 20 minutes for each reply from the relay.
# GAMEND_MAIL_SEND_TIMEOUT_MS=30000

# GAMEND_MAIL_SMTP_FROM_EMAIL=

# GAMEND_MAIL_SMTP_FROM_NAME=Gamend

# SMTP password, or the provider's API key.
# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# Secret — never commit a real value.
# GAMEND_MAIL_SMTP_PASSWORD=

# GAMEND_MAIL_SMTP_PORT=465

# SMTP host, e.g. smtp.resend.com.
# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# GAMEND_MAIL_SMTP_RELAY=

# TLS server name indication. Defaults to the relay host.
# GAMEND_MAIL_SMTP_SNI=

# GAMEND_MAIL_SMTP_SSL=true

# STARTTLS policy: never | if_available | always.
# GAMEND_MAIL_SMTP_TLS=never

# Expected in production — logs a warning when missing, if any of smtp_password/smtp_relay/smtp_username is set.
# GAMEND_MAIL_SMTP_USERNAME=

# ──────────────────────────────────────────────────────────────────────────
# Hooks
# ──────────────────────────────────────────────────────────────────────────

# The same, for a hook called inside a database transaction: on SQLite that
# transaction holds the only write connection while the hook runs.
# GAMEND_HOOKS_CALL_TIMEOUT_IN_TRANSACTION_MS=5000

# How long a plugin hook or RPC may run before it is killed, in ms. The
# caller's request waits that long.
# GAMEND_HOOKS_CALL_TIMEOUT_MS=60000

# Log a hook call as slow when it takes longer than this, in ms.
# GAMEND_HOOKS_SLOW_THRESHOLD_MS=200

# ──────────────────────────────────────────────────────────────────────────
# IndexNow
# ──────────────────────────────────────────────────────────────────────────

# Notify IndexNow search engines (Bing, Yandex, Seznam — not Google) when
# pages change.
# GAMEND_INDEX_NOW_ENABLED=false

# IndexNow submission endpoint. Any participating engine's endpoint reaches
# all of them.
# GAMEND_INDEX_NOW_ENDPOINT=https://api.indexnow.org/indexnow

# IndexNow key, 8-128 hex characters. Public by design — it is served at
# /<key>.txt to prove domain ownership.
# Expected in production — logs a warning when missing, when index_now.enabled is true.
# GAMEND_INDEX_NOW_KEY=

# How long to wait for the IndexNow endpoint before giving up.
# GAMEND_INDEX_NOW_TIMEOUT_MS=10000

# ──────────────────────────────────────────────────────────────────────────
# Limits
# ──────────────────────────────────────────────────────────────────────────

# Largest match a ticket forms when it does not say. At most
# max_matchmaking_players.
# GAMEND_LIMITS_MATCHMAKING_DEFAULT_MAX_PLAYERS=5

# Smallest match a ticket forms when it does not say.
# GAMEND_LIMITS_MATCHMAKING_DEFAULT_MIN_PLAYERS=2

# Grace before an offline player's ticket is pruned; long enough that a
# brief disconnect keeps its queue position.
# GAMEND_LIMITS_MATCHMAKING_OFFLINE_GRACE_MS=300000

# Sweep interval of the matchmaking worker.
# GAMEND_LIMITS_MATCHMAKING_TICK_MS=3000

# How long the oldest ticket waits before a below-max group still forms.
# GAMEND_LIMITS_MATCHMAKING_TIMEOUT_MS=30000

# Progress rows a user may hold in the current periods; excess events are
# ignored.
# GAMEND_LIMITS_MAX_ACTIVE_QUESTS_PER_USER=200

# Personal API tokens one user may hold, revoked ones not counted.
# GAMEND_LIMITS_MAX_API_TOKENS_PER_USER=10

# GAMEND_LIMITS_MAX_CHAT_CONTENT=4096

# GAMEND_LIMITS_MAX_CHAT_FILTER_WORD_LEN=64

# Blocklist size cap. Sized to hold the bundled word lists for several
# languages.
# GAMEND_LIMITS_MAX_CHAT_FILTER_WORDS=10000

# Rolling 24h; 0 disables. Needs rate limiting on; ETS backend counts per
# instance.
# GAMEND_LIMITS_MAX_CHAT_MESSAGES_PER_DAY=5000

# Rolling 24h; 0 disables. Needs rate limiting on; ETS backend counts per
# instance.
# GAMEND_LIMITS_MAX_CHAT_REPORTS_PER_USER_PER_DAY=50

# GAMEND_LIMITS_MAX_DEVICE_ID=256

# Max display-name length in codepoints. 255 is the users.display_name
# column's own limit on Postgres (varchar(255)); higher fails the insert
# there.
# GAMEND_LIMITS_MAX_DISPLAY_NAME=255

# GAMEND_LIMITS_MAX_EMAIL=160

# GAMEND_LIMITS_MAX_FRIENDS_PER_USER=500

# GAMEND_LIMITS_MAX_GROUP_DESCRIPTION=500

# GAMEND_LIMITS_MAX_GROUP_MEMBERS=10000

# GAMEND_LIMITS_MAX_GROUP_PENDING_INVITES=100

# GAMEND_LIMITS_MAX_GROUP_TITLE=80

# GAMEND_LIMITS_MAX_GROUPS_CREATED_PER_USER=20

# GAMEND_LIMITS_MAX_GROUPS_PER_USER=50

# GAMEND_LIMITS_MAX_HOOK_ARGS_COUNT=32

# GAMEND_LIMITS_MAX_HOOK_ARGS_SIZE=65536

# GAMEND_LIMITS_MAX_KV_ENTRIES_PER_USER=1000

# GAMEND_LIMITS_MAX_KV_KEY=512

# GAMEND_LIMITS_MAX_KV_VALUE_SIZE=65536

# GAMEND_LIMITS_MAX_LEADERBOARD_DESCRIPTION=1000

# GAMEND_LIMITS_MAX_LEADERBOARD_SLUG=100

# GAMEND_LIMITS_MAX_LEADERBOARD_TITLE=255

# GAMEND_LIMITS_MAX_LOBBY_PASSWORD=128

# GAMEND_LIMITS_MAX_LOBBY_TITLE=80

# GAMEND_LIMITS_MAX_LOBBY_USERS=128

# Serialized byte size of a ticket's match_params map.
# GAMEND_LIMITS_MAX_MATCHMAKING_PARAMS_SIZE=2048

# Hard cap on a ticket's own max_players setting.
# GAMEND_LIMITS_MAX_MATCHMAKING_PLAYERS=64

# GAMEND_LIMITS_MAX_METADATA_SIZE=16384

# GAMEND_LIMITS_MAX_MUTE_REASON=500

# GAMEND_LIMITS_MAX_NOTIFICATION_CONTENT=10000

# GAMEND_LIMITS_MAX_NOTIFICATION_TITLE=255

# GAMEND_LIMITS_MAX_NOTIFICATIONS_PER_USER=500

# GAMEND_LIMITS_MAX_OBJECTIVES_PER_QUEST=10

# GAMEND_LIMITS_MAX_PAGE_SIZE=100

# GAMEND_LIMITS_MAX_PARTY_PENDING_INVITES=20

# GAMEND_LIMITS_MAX_PARTY_SIZE=32

# GAMEND_LIMITS_MAX_PENDING_FRIEND_REQUESTS=100

# GAMEND_LIMITS_MAX_PROFILE_URL=2048

# GAMEND_LIMITS_MAX_PUSH_BODY=4000

# Serialized byte size of a push message's custom data map.
# GAMEND_LIMITS_MAX_PUSH_DATA_SIZE=4096

# GAMEND_LIMITS_MAX_PUSH_TITLE=255

# Live (non-disabled) device tokens per user.
# GAMEND_LIMITS_MAX_PUSH_TOKENS_PER_USER=20

# GAMEND_LIMITS_MAX_QUEST_CATEGORY=64

# GAMEND_LIMITS_MAX_QUEST_DESCRIPTION=1000

# GAMEND_LIMITS_MAX_QUEST_KEY=100

# Days of daily/weekly period history kept before the retention prune.
# GAMEND_LIMITS_MAX_QUEST_PERIOD_HISTORY=90

# GAMEND_LIMITS_MAX_QUEST_REWARD_ENTRIES=10

# GAMEND_LIMITS_MAX_QUEST_TITLE=255

# GAMEND_LIMITS_MAX_QUESTS=500

# Hard cap on participants in one check.
# GAMEND_LIMITS_MAX_READY_CHECK_PARTICIPANTS=64

# GAMEND_LIMITS_MAX_REPORT_REASON=500

# Concurrent sockets per user. 0 disables; counted per app instance.
# GAMEND_LIMITS_MAX_SOCKETS_PER_USER=20

# GAMEND_LIMITS_MAX_TOURNAMENT_BRACKET_SIZE=256

# GAMEND_LIMITS_MAX_TOURNAMENT_DESCRIPTION=1000

# Hard cap on a tournament's own max_entries setting.
# GAMEND_LIMITS_MAX_TOURNAMENT_ENTRIES=10000

# GAMEND_LIMITS_MAX_TOURNAMENT_SLUG=100

# GAMEND_LIMITS_MAX_TOURNAMENT_TITLE=255

# Max size of a single uploaded object (avatars/UGC). 5 MiB.
# GAMEND_LIMITS_MAX_UPLOAD_BYTES=5242880

# Max total bytes one owner may hold under an upload prefix. Caps the
# orphans left by tickets a client requests but never confirms. 50 MiB.
# GAMEND_LIMITS_MAX_UPLOAD_BYTES_PER_OWNER=52428800

# GAMEND_LIMITS_MAX_USERNAME=32

# GAMEND_LIMITS_MIN_USERNAME=3

# Default answering window. Overridable per check by the caller.
# GAMEND_LIMITS_READY_CHECK_TIMEOUT_MS=15000

# Keep username handles to a-z, 0-9 and . _ - (the GitHub and Discord
# model). Input is still normalized first, so WANG in fullwidth becomes
# wang; display names stay Unicode.
# GAMEND_LIMITS_USERNAME_ASCII_ONLY=false

# ──────────────────────────────────────────────────────────────────────────
# Lobby snapshots
# ──────────────────────────────────────────────────────────────────────────

# Record a durable per-run snapshot of lobby state, browsable at
# /admin/lobby_snapshots.
# GAMEND_LOBBY_SNAPSHOTS_ENABLED=false

# Cap on KV entries captured per snapshot.
# GAMEND_LOBBY_SNAPSHOTS_MAX_KV_ENTRIES=200

# User-scoped KV keys to capture. Empty captures none — the widest exposure
# in a snapshot.
# GAMEND_LOBBY_SNAPSHOTS_USER_KV_KEYS=

# ──────────────────────────────────────────────────────────────────────────
# OAuth providers
# ──────────────────────────────────────────────────────────────────────────

# Services id (web audience) for Sign in with Apple.
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_CLIENT_ID=

# Offer apple sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_APPLE_ENABLED=true

# Bundle id (iOS audience) used when verifying Apple ID tokens.
# GAMEND_OAUTH_APPLE_IOS_CLIENT_ID=

# Key id of the Sign in with Apple auth key (Apple Developer -> Keys).
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_KEY_ID=

# Contents of the Sign in with Apple .p8 key.
# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_APPLE_PRIVATE_KEY=

# Expected in production — logs a warning when missing, if any of apple_client_id/apple_team_id/apple_key_id/apple_private_key is set.
# GAMEND_OAUTH_APPLE_TEAM_ID=

# Expected in production — logs a warning when missing, if any of discord_client_secret is set.
# GAMEND_OAUTH_DISCORD_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of discord_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_DISCORD_CLIENT_SECRET=

# Offer discord sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_DISCORD_ENABLED=true

# Expected in production — logs a warning when missing, if any of facebook_client_secret is set.
# GAMEND_OAUTH_FACEBOOK_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of facebook_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_FACEBOOK_CLIENT_SECRET=

# Offer facebook sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_FACEBOOK_ENABLED=true

# Expected in production — logs a warning when missing, if any of github_client_secret is set.
# GAMEND_OAUTH_GITHUB_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of github_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_GITHUB_CLIENT_SECRET=

# Offer github sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_GITHUB_ENABLED=true

# Expected in production — logs a warning when missing, if any of google_client_secret is set.
# GAMEND_OAUTH_GOOGLE_CLIENT_ID=

# Expected in production — logs a warning when missing, if any of google_client_id is set.
# Secret — never commit a real value.
# GAMEND_OAUTH_GOOGLE_CLIENT_SECRET=

# Offer google sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_GOOGLE_ENABLED=true

# Native-app client id used to verify Google ID tokens from SDK sign-in.
# GAMEND_OAUTH_GOOGLE_WEB_CLIENT_ID=

# Steam Web API key, used for OpenID sign-in.
# Secret — never commit a real value.
# GAMEND_OAUTH_STEAM_API_KEY=

# GAMEND_OAUTH_STEAM_APP_ID=

# Offer steam sign-in. Only takes effect once its credentials are set.
# GAMEND_OAUTH_STEAM_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────

# Level for per-request access logs, or `off` to silence them.
# GAMEND_OBSERVABILITY_ACCESS_LOG_LEVEL=debug

# Public Grafana URL linked from the admin dashboard, if you host one.
# GAMEND_OBSERVABILITY_GRAFANA_URL=

# Level for the rotating file handler.
# GAMEND_OBSERVABILITY_LOG_FILE_LEVEL=info

# Bytes per rotated file.
# GAMEND_OBSERVABILITY_LOG_FILE_MAX_BYTES=10000000

# How many rotated files to keep. With the default size, ~50MB of disk.
# GAMEND_OBSERVABILITY_LOG_FILE_MAX_FILES=5

# Write a rotating log file alongside stdout. Unset disables the file
# handler.
# GAMEND_OBSERVABILITY_LOG_FILE_PATH=

# Application log level: debug | info | warning | error.
# GAMEND_OBSERVABILITY_LOG_LEVEL=info

# When set, every non-loopback /metrics scrape must send `Authorization:
# Bearer <token>`. Accepts the token inline or a path to a file holding it
# (e.g. a docker secret).
# Secret — never commit a real value.
# GAMEND_OBSERVABILITY_METRICS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Payments
# ──────────────────────────────────────────────────────────────────────────

# GAMEND_PAYMENTS_APPLE_APP_STORE_SERVER_BASE_URL=

# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# GAMEND_PAYMENTS_APPLE_BUNDLE_ID=

# Issuer id from App Store Connect -> Users and Access -> Integrations.
# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_APPLE_ISSUER_ID=

# Key id of the App Store Connect API key — not the Sign in with Apple key.
# Expected in production — logs a warning when missing, if any of apple_bundle_id/apple_issuer_id/apple_key_id is set.
# GAMEND_PAYMENTS_APPLE_KEY_ID=

# Inline .p8 contents for the App Store Connect API key.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_APPLE_PRIVATE_KEY=

# GAMEND_PAYMENTS_APPLE_PRIVATE_KEY_PATH=

# sandbox while validating, production for real transactions.
# GAMEND_PAYMENTS_ENVIRONMENT=production

# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_ACCESS_TOKEN=

# GAMEND_PAYMENTS_GOOGLE_PLAY_AUTO_ACKNOWLEDGE=false

# Expected in production — logs a warning when missing, if any of google_play_package_name/google_play_service_account_json is set.
# GAMEND_PAYMENTS_GOOGLE_PLAY_PACKAGE_NAME=

# GAMEND_PAYMENTS_GOOGLE_PLAY_PUBLISHER_BASE_URL=

# Shared bearer token on the Pub/Sub push webhook. Without it the RTDN
# endpoint fails closed in production.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_RTDN_TOKEN=

# Inline service-account JSON. Use the _PATH variant to read it from a file
# instead.
# Expected in production — logs a warning when missing, if any of google_play_package_name/google_play_service_account_json is set.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# GAMEND_PAYMENTS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=

# GAMEND_PAYMENTS_STEAM_APP_ID=

# GAMEND_PAYMENTS_STEAM_MICROTXN_BASE_URL=

# Falls back to the OAuth Steam key when unset.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STEAM_WEB_API_KEY=

# GAMEND_PAYMENTS_STRIPE_API_VERSION=2022-11-15

# Sell through Stripe Managed Payments (Stripe is merchant of record: it
# charges and remits the buyer's VAT). Accept the terms and set a tax code
# on every product in the Stripe Dashboard first.
# GAMEND_PAYMENTS_STRIPE_MANAGED_PAYMENTS=false

# sk_live_... key, used when environment is production.
# Expected in production — logs a warning when missing, when payments.environment is :production.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_PRODUCTION_SECRET_KEY=

# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_PRODUCTION_WEBHOOK_SECRET=

# sk_test_... key, used when environment is sandbox.
# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_SANDBOX_SECRET_KEY=

# Secret — never commit a real value.
# GAMEND_PAYMENTS_STRIPE_SANDBOX_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Presence
# ──────────────────────────────────────────────────────────────────────────

# How often users still marked online after a crash are looked for, in ms.
# GAMEND_PRESENCE_INTERVAL_MS=120000

# Mark a user offline once their last_seen_at is this many seconds old.
# Connected sockets refresh it at three fifths of this, at most every 3
# minutes.
# GAMEND_PRESENCE_STALE_THRESHOLD_S=300

# ──────────────────────────────────────────────────────────────────────────
# Public features
# ──────────────────────────────────────────────────────────────────────────

# GET /api/v1/groups*, the "groups" channel and the /groups pages.
# GAMEND_FEATURES_LIST_GROUPS=true

# Public GET/resolve /api/v1/leaderboards* and the /leaderboards pages.
# GAMEND_FEATURES_LIST_LEADERBOARDS=true

# GET /api/v1/lobbies and the "lobbies" channel.
# GAMEND_FEATURES_LIST_LOBBIES=true

# GET /api/v1/matchmaking/stats. Own-ticket endpoints stay.
# GAMEND_FEATURES_LIST_MATCHMAKING=true

# Public GET /api/v1/quests* and the /quests page.
# GAMEND_FEATURES_LIST_QUESTS=true

# Public GET /api/v1/tournaments* and the /tournaments pages.
# GAMEND_FEATURES_LIST_TOURNAMENTS=true

# GET /api/v1/users and /users/:id.
# GAMEND_FEATURES_LIST_USERS=true

# Serve the in-browser mailbox at /dev/mailbox outside dev. Every sent email
# is readable there.
# GAMEND_FEATURES_MAILBOX_PREVIEW=false

# OpenAPI spec + Swagger UI. A complete map of your API — consider off in
# production.
# GAMEND_FEATURES_OPENAPI=true

# The /play page, which hands a signed-in player a token for the game
# client.
# GAMEND_FEATURES_PLAY=true

# The unauthenticated stats endpoints: GET /api/v1/stats,
# /api/v1/users/stats, /api/v1/lobbies/stats, /api/v1/parties/stats,
# /api/v1/quests/stats, /api/v1/signaling/stats and
# /api/v1/matchmaking/stats, plus the /stats page. Aggregate counts only,
# never per-row data — but they do reveal how busy the server is.
# GAMEND_FEATURES_PUBLIC_STATS=true

# Top-level `user.metadata` keys GET /api/v1/users and /users/:id may
# return. Empty means none. Those endpoints are unauthenticated, so anything
# named here is world-readable and findable by name prefix — never list a
# key holding position, routing or contact data.
# GAMEND_FEATURES_PUBLIC_USER_METADATA_KEYS=

# Player-supplied images: avatars (POST /api/v1/me/avatar*) and group icons
# (POST /api/v1/groups/:id/icon*). Objects land in public storage and are
# served without authentication, so on a service children can reach this is
# an unscreened image surface — turn it off unless the game actually uses it
# and you have a way to screen what arrives.
# GAMEND_FEATURES_USER_IMAGE_UPLOADS=true

# ──────────────────────────────────────────────────────────────────────────
# Push notifications
# ──────────────────────────────────────────────────────────────────────────

# Set to `log` to route every delivery to the Log provider, credentials or
# not.
# GAMEND_PUSH_ADAPTER=auto

# `production`, or `sandbox` for dev builds.
# GAMEND_PUSH_APNS_ENV=production

# 10-character key id of the APNs auth key.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_KEY_ID=

# APNs .p8 key contents, or a path to the file.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# Secret — never commit a real value.
# GAMEND_PUSH_APNS_PRIVATE_KEY=

# Apple developer team id.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_TEAM_ID=

# App bundle id, sent as apns-topic.
# Expected in production — logs a warning when missing, if any of apns_private_key/apns_key_id/apns_team_id/apns_topic is set.
# GAMEND_PUSH_APNS_TOPIC=

# FCM service-account JSON, inline or a path to the file.
# Secret — never commit a real value.
# GAMEND_PUSH_FCM_CREDENTIALS=

# Defaults to the project id inside the FCM credentials.
# GAMEND_PUSH_FCM_PROJECT_ID=

# Per-node concurrent deliveries on the push queue.
# GAMEND_PUSH_QUEUE_CONCURRENCY=10

# ──────────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────────

# Max login/register requests per window, per IP.
# GAMEND_RATELIMIT_AUTH_LIMIT=10

# Auth HTTP window, in milliseconds.
# GAMEND_RATELIMIT_AUTH_WINDOW_MS=60000

# ets (per-node counters) or redis (shared across instances).
# GAMEND_RATELIMIT_BACKEND=ets

# Max client log batch uploads per window, per IP.
# GAMEND_RATELIMIT_CLIENT_LOGS_LIMIT=30

# Client log upload window, in milliseconds.
# GAMEND_RATELIMIT_CLIENT_LOGS_WINDOW_MS=60000

# Max WebRTC DataChannel messages per window, per user.
# GAMEND_RATELIMIT_DC_LIMIT=300

# WebRTC DataChannel window, in milliseconds.
# GAMEND_RATELIMIT_DC_WINDOW_MS=10000

# Master switch for all request/message throttling.
# GAMEND_RATELIMIT_ENABLED=true

# Max general HTTP requests per window, per IP.
# GAMEND_RATELIMIT_GENERAL_LIMIT=240

# General HTTP window, in milliseconds.
# GAMEND_RATELIMIT_GENERAL_WINDOW_MS=60000

# Max ICE candidate messages per window, per user.
# GAMEND_RATELIMIT_ICE_LIMIT=150

# ICE candidate window, in milliseconds.
# GAMEND_RATELIMIT_ICE_WINDOW_MS=30000

# Redis URL for shared counters.
# REQUIRED in production — the server refuses to start without it, when ratelimit.backend is :redis.
# GAMEND_RATELIMIT_REDIS_URL=

# Max ICE candidates relayed over the signaling channel per window, per
# user.
# GAMEND_RATELIMIT_SIGNALING_ICE_LIMIT=150

# Signaling ICE window, in milliseconds.
# GAMEND_RATELIMIT_SIGNALING_ICE_WINDOW_MS=30000

# Max signaling channel messages per window, per user.
# GAMEND_RATELIMIT_SIGNALING_WS_LIMIT=300

# Signaling channel window, in milliseconds.
# GAMEND_RATELIMIT_SIGNALING_WS_WINDOW_MS=10000

# Max WebSocket channel messages per window, per user.
# GAMEND_RATELIMIT_WS_LIMIT=60

# WebSocket window, in milliseconds.
# GAMEND_RATELIMIT_WS_WINDOW_MS=10000

# ──────────────────────────────────────────────────────────────────────────
# Realtime
# ──────────────────────────────────────────────────────────────────────────

# Hold outbound state updates this long and push only the latest per object.
# 0 pushes immediately.
# GAMEND_REALTIME_DEBOUNCE_MS=0

# Phoenix.Presence tracker shards. Must match on every node in a cluster;
# needs a full restart to change.
# GAMEND_REALTIME_PRESENCE_POOL_SIZE=1

# Phoenix.PubSub shards. Raise on nodes holding many thousands of sockets.
# GAMEND_REALTIME_PUBSUB_POOL_SIZE=1

# Cap the per-connection socket read buffer, in KB. 0 leaves the OS default.
# Only lowers memory on platforms that honour it; does not change the TCP
# window.
# GAMEND_REALTIME_SOCKET_BUFFER_KB=0

# Largest single WebSocket frame a game client may send, in bytes.
# GAMEND_REALTIME_SOCKET_MAX_FRAME_BYTES=131072

# How long a game socket may stay silent before it is closed, in ms. Longer
# keeps alt-tabbed players; shorter frees half-open sockets (and their
# seats) sooner.
# GAMEND_REALTIME_SOCKET_TIMEOUT_MS=300000

# ──────────────────────────────────────────────────────────────────────────
# Retention
# ──────────────────────────────────────────────────────────────────────────

# Delete lobbies nobody has been seen in for N minutes, and release the seat
# of a player offline that long in a lobby still in use. 0 disables both.
# GAMEND_RETENTION_ABANDONED_LOBBY_MINUTES=15

# Disband parties nobody has been seen in for N minutes. 0 disables.
# GAMEND_RETENTION_ABANDONED_PARTY_MINUTES=15

# Delete per-user daily activity rows (DAU / D1-D7-D30 source) older than N
# days. 0 keeps forever. Below 60 the admin retention cohorts go blank.
# GAMEND_RETENTION_ACTIVITY_DAYS=0

# Delete device-only accounts inactive for N days. 0 keeps forever. These
# accounts cost one unauthenticated request to create, so they are the tier
# that actually needs a sweep.
# GAMEND_RETENTION_ANONYMOUS_USERS_DAYS=90

# Rows deleted per statement. Lower it if a sweep stalls gameplay writes on
# SQLite, where each statement holds the write lock.
# GAMEND_RETENTION_BATCH_SIZE=500

# Delete chat messages older than N days. 0 keeps forever.
# GAMEND_RETENTION_CHAT_MESSAGES_DAYS=0

# Delete accounts with a real identity after N days of inactivity. 0 (the
# default) keeps forever - deleting a player who comes back is worse than
# the storage. 730 matches what Google and Microsoft use if you turn it on.
# GAMEND_RETENTION_INACTIVE_USERS_DAYS=0

# Email a warning this many days before an inactive account is deleted. 0
# deletes with no warning. Accounts with no email address cannot be warned.
# GAMEND_RETENTION_INACTIVE_USERS_WARN_DAYS=30

# Hours between full retention sweeps. The first runs five minutes after
# boot.
# GAMEND_RETENTION_INTERVAL_HOURS=6

# Delete resolved invites and join requests N days after resolution.
# GAMEND_RETENTION_INVITES_DAYS=30

# Delete wallet/inventory ledger entries older than N days. 0 keeps forever.
# GAMEND_RETENTION_LEDGER_DAYS=0

# Seconds between sweeps of the classes that free live state: offline lobby
# and party seats, abandoned parties, abandoned lobbies. 0 leaves them to
# the full sweep.
# GAMEND_RETENTION_LIVE_INTERVAL_SECONDS=60

# Delete lobby snapshots, events and blobs older than N days.
# GAMEND_RETENTION_LOBBY_SNAPSHOTS_DAYS=30

# Longer window for snapshots of runs flagged anomalous.
# GAMEND_RETENTION_LOBBY_SNAPSHOTS_FLAGGED_DAYS=90

# Delete matchmaking tickets older than N hours, in any status.
# GAMEND_RETENTION_MATCHMAKING_TICKETS_HOURS=24

# Delete notifications older than N days. 0 keeps forever.
# GAMEND_RETENTION_NOTIFICATIONS_DAYS=0

# Delete payment provider webhook events older than N days. Purchases are
# never pruned.
# GAMEND_RETENTION_PAYMENT_EVENTS_DAYS=0

# Delete push tokens untouched for N days. Defaults to Google's stale-token
# guidance.
# GAMEND_RETENTION_PUSH_TOKENS_DAYS=270

# Delete finished tournaments older than N days. 0 keeps forever.
# GAMEND_RETENTION_TOURNAMENTS_DAYS=0

# Delete email accounts that never confirmed their address and have been
# inactive for N days. 0 keeps forever. Accounts that also have a provider
# login are kept.
# GAMEND_RETENTION_UNCONFIRMED_USERS_DAYS=30

# ──────────────────────────────────────────────────────────────────────────
# Secrets
# ──────────────────────────────────────────────────────────────────────────

# Comma-separated id:key pairs for encrypting customer secrets, each key 32
# bytes base64. The first is used for new writes; the rest let rows written
# before a rotation still be read. Unset disables the store.
# Secret — never commit a real value.
# GAMEND_SECRETS_KEYS=

# ──────────────────────────────────────────────────────────────────────────
# Server & HTTP
# ──────────────────────────────────────────────────────────────────────────

# Browser CORS/WebSocket origin allowlist. Empty allows any origin. Prefix
# an entry with `regex:` for a pattern.
# GAMEND_HTTP_ALLOWED_ORIGINS=

# Retries of a failed GET to a provider. POSTs are never retried. 0
# disables.
# GAMEND_HTTP_CLIENT_RETRIES=1

# Per-try timeout for calls to payment, OAuth and avatar providers, in
# milliseconds: connecting, and waiting for the response.
# GAMEND_HTTP_CLIENT_TIMEOUT_MS=10000

# Public hostname, used to build URLs and OAuth redirect URIs.
# GAMEND_HTTP_HOST=localhost

# Largest request body the server reads (JSON, form or multipart), in bytes.
# Raise it with any GAMEND_LIMITS_* size above 1 MB, or requests that size
# are refused first. Local-backend uploads are capped by
# GAMEND_LIMITS_MAX_UPLOAD_BYTES instead.
# GAMEND_HTTP_MAX_BODY_BYTES=1048576

# TCP port the HTTP listener binds.
# GAMEND_HTTP_PORT=4000

# http or https. Defaults to http for localhost, https otherwise.
# GAMEND_HTTP_SCHEME=

# Start the HTTP listener. Only needed when running as a release.
# GAMEND_HTTP_SERVER=false

# ──────────────────────────────────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────────────────────────────────

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# Secret — never commit a real value.
# GAMEND_STORAGE_ACCESS_KEY_ID=

# Backend for avatars and uploads: local | s3 (any S3-compatible service).
# GAMEND_STORAGE_ADAPTER=local

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# GAMEND_STORAGE_BUCKET=

# Directory the local adapter writes objects to. Point this at persistent
# storage (a mounted volume) in production — the default lives with the app
# and does not survive a redeploy.
# GAMEND_STORAGE_DIR=priv/storage

# Custom endpoint, e.g. https://<account>.r2.cloudflarestorage.com.
# GAMEND_STORAGE_ENDPOINT=

# Key prefixes GET /storage/<key> serves to anyone. Add one only for keys
# that carry enough randomness to be unguessable; the rest need the admin
# API.
# GAMEND_STORAGE_PUBLIC_PREFIXES=avatars/,icons/

# CDN or base URL serving stored objects, whichever backend is behind it.
# GAMEND_STORAGE_PUBLIC_URL=

# Region, or "auto" for services that do not use one (R2, MinIO).
# GAMEND_STORAGE_REGION=auto

# REQUIRED in production — the server refuses to start without it, when storage.adapter is :s3.
# Secret — never commit a real value.
# GAMEND_STORAGE_SECRET_ACCESS_KEY=

# Lifetime of the signed link /storage/<key> redirects to, for an S3 bucket
# with no public_url. S3 caps it at 604800 (7 days).
# GAMEND_STORAGE_SIGNED_URL_SECONDS=3600

# How long an upload ticket stays valid, in seconds. Raise it for large
# uploads over slow connections.
# GAMEND_STORAGE_UPLOAD_TTL_SECONDS=600

# ──────────────────────────────────────────────────────────────────────────
# TLS & certificates
# ──────────────────────────────────────────────────────────────────────────

# Webroot for Let's Encrypt HTTP-01 challenge files. Defaults to
# /var/www/acme.
# GAMEND_TLS_ACME_WEBROOT=

# Path to fullchain.pem (certificate + CA chain).
# Expected in production — logs a warning when missing, if any of certfile/keyfile is set.
# GAMEND_TLS_CERTFILE=

# Redirect HTTP to HTTPS. Off unless set: a host that serves port 80 itself
# keeps a plain-HTTP twin of every page until you enable it. Read per
# request by GamendWeb.Plugs.ForceSSL; HSTS is sent on every HTTPS response
# regardless, by GamendWeb.Plugs.SecurityHeaders.
# GAMEND_TLS_FORCE=

# Path to privkey.pem.
# Expected in production — logs a warning when missing, if any of certfile/keyfile is set.
# GAMEND_TLS_KEYFILE=

# HTTPS listen port.
# GAMEND_TLS_PORT=443

# ──────────────────────────────────────────────────────────────────────────
# Tournaments
# ──────────────────────────────────────────────────────────────────────────

# Seconds between tournament ticks: state transitions, match-ready, deadline
# sweeps and recurrence. A round can start or time out up to this late.
# GAMEND_TOURNAMENTS_TICK_INTERVAL_SECONDS=30

# ──────────────────────────────────────────────────────────────────────────
# WebRTC
# ──────────────────────────────────────────────────────────────────────────

# Comma-separated STUN server URLs. Empty uses none.
# GAMEND_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Credential for the TURN servers.
# Expected in production — logs a warning when missing, if any of turn_username is set.
# Secret — never commit a real value.
# GAMEND_WEBRTC_TURN_CREDENTIAL=

# Comma-separated TURN server URLs (turn:host:3478, turns:host:5349). Empty
# uses none. Only needed when the server itself is behind NAT or UDP is
# filtered.
# GAMEND_WEBRTC_TURN_URLS=

# Username for the TURN servers.
# Expected in production — logs a warning when missing, if any of turn_credential is set.
# GAMEND_WEBRTC_TURN_USERNAME=
