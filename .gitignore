# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
gamend-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json
/priv/static/**/*.gz
# Brotli copies, written by bin/compress-static in `mix assets.deploy`. Same
# build output as the .gz above; only the .gz line existed, so the .br files
# were committed and every build showed them as modified.
/priv/static/**/*.br
/priv/static/**/*-????????????????????????????????.*

# Umbrella layout: ignore generated/digested static assets in the web app
/apps/gamend_web/priv/static/
!/apps/gamend_web/priv/static/game/
!/apps/gamend_web/priv/static/fonts/
!/apps/gamend_web/priv/static/images/
!/apps/gamend_web/priv/static/favicon.ico
!/apps/gamend_web/priv/static/robots.txt
/apps/gamend_web/apps/gamend_web/priv/static/
# Stray output when host_config.exs is evaluated with host_root pointing at apps/
/apps/priv/

# Pre-optimization copies of priv/static/images, written by
# mix host.optimize_images before it rewrites a source in place.
/priv/image_backups/

# Object storage, local backend (Gamend.Storage.Local) — user uploads,
# avatars and other stored objects live here in dev; never source-controlled.
/apps/gamend_core/priv/storage/
/priv/storage/

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/
/apps/gamend_web/assets/node_modules/

.DS_Store
.elixir_ls/

# Environment variables
.env

redis/
/db/
clients/javascript/
clients/node_modules/
clients/godot/
clients/addons/
godot_addons/addons/gamend/
# Generated by clients/generate_cpp.sh; CI releases it as gamend-cpp-sdk.tar.gz.
/cpp_sdk/
/csharp_sdk/
/rust_sdk/
clients/cpp_template/build/
# Load-test output. The directory itself is tracked (k6 cannot create it).
stress/results/*
!stress/results/.gitkeep
clients/gamend/
sdk_tools/doc/

# Translation CSV exports (generated by mix gettext.export_csv)
/translations/*.csv
/scripts/
apps/gamend_web/apps/gamend_web/priv/static/cache_manifest.json
apps/gamend_web/apps/gamend_web/priv/static/favicon-0793a89617220e350e9e66698d2d4fa8.ico
apps/gamend_web/apps/gamend_web/priv/static/favicon.ico
*.pyc
translations/google_sheets_translations.py
translations/README.md
translations/GOOGLE_SHEETS_README.md
translations/credentials.json
translations/token.json

# GeoIP MMDB databases (large binary files, download separately)
data/*.mmdb
data/COPYRIGHT.txt
data/LICENSE.txt
apps/gamend_core/_build/
apps/gamend_core/deps/
apps/gamend_web/_build/
apps/gamend_web/deps/
apps/gamend_web/priv/db/
apps/gamend_core/priv/db/

# Rotating log files (dev: log/dev.log, docker compose: logs/).
/log/
/logs/

# Staged single-plugin dir for measurement runs (see stress/README.md)
stress/.plugins/
apps/gamend_web/game_server_test.db
