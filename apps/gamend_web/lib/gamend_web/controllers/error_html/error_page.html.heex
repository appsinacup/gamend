<!DOCTYPE html>
<html
  lang={LocalePath.url_locale(@locale)}
  dir={LocalePath.text_direction(@locale)}
  data-theme={@color_mode}
  class="bg-base-100"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={@color_mode} />
    <%!-- A 404 is a real URL returning real HTML, so a crawler that ignores the
          status code would otherwise file it as a thin page. --%>
    <meta name="robots" content="noindex, nofollow" />
    <title>{@title}</title>
    <link rel="icon" href="/favicon.ico" />
    <%!-- The site's own stylesheet, loaded exactly as the root layout loads it
          (SRI included), so an error page looks like the rest of the site
          instead of inventing its own palette. Everything below is styled with
          the same daisyUI tokens the app uses, which is also what makes it
          follow the reader's light/dark theme.

          If the bundle ever fails to load this degrades to unstyled semantic
          HTML — still readable, still navigable, which is the right failure
          mode for the page you land on when something already went wrong. --%>
    <link
      rel="stylesheet"
      href={SRI.versioned_path(~p"/assets/css/app.css")}
      integrity={SRI.integrity(~p"/assets/css/app.css")}
      crossorigin="anonymous"
    />
    <%!-- The host's theme, same as the root layout. app.css alone gives
          daisyUI's *default* palette, so the page came out orange in light and
          indigo in dark while the site's own primary is #994F7D. The brand
          colours live here, not in the bundle. --%>
    <link
      :if={@theme_css}
      rel="stylesheet"
      href={SRI.versioned_path(@theme_css) || @theme_css}
      integrity={SRI.integrity(@theme_css)}
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <main class="mx-auto flex min-h-screen max-w-narrow flex-col items-center justify-center px-6 text-center">
      <p class="text-7xl font-black tracking-tight text-primary sm:text-8xl">{@status}</p>
      <h1 class="mt-2 text-2xl font-bold">{@title}</h1>
      <p class="mt-3 text-muted">{@message}</p>

      <nav
        class="mt-8 flex flex-wrap justify-center gap-2"
        aria-label={gettext("Where to go next")}
      >
        <a class="btn btn-primary" href={@home_path}>{gettext("Home")}</a>
        <a :for={link <- @links} class="btn btn-ghost" href={@home_path <> link.path}>
          {link.label}
        </a>
      </nav>
    </main>
  </body>
</html>
