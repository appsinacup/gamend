<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-center">
    <div class="mt-4 flex items-center justify-center gap-3">
      <.back_link href={home_path()} />
      <h1 class="text-4xl font-black text-base-content">
        Data Deletion Instructions
      </h1>
    </div>
    <p class="mt-4 leading-7 text-muted max-w-narrow mx-auto">
      Follow these instructions to request deletion of your personal data from our service.
    </p>
  </div>

  <div class="mt-12 max-w-narrow mx-auto space-y-8">
    <section>
      <h2 class="text-xl font-semibold mb-4">How to Request Data Deletion</h2>
      <div class="space-y-4 text-muted">
        <p>To request deletion of your personal data, you can:</p>
        <ol class="list-decimal ps-6 space-y-2">
          <li>
            <strong>Via the Application:</strong>
            Log in to your account and go to Account → Delete account
          </li>
          <li>
            <strong>Contact Support:</strong>
            <span :if={@contact_email}>
              Send an email to
              <a href={"mailto:" <> @contact_email} class="link link-primary">{@contact_email}</a>
              from the address on your account, requesting data deletion
            </span>
            <span :if={!@contact_email}>
              Send an email to our support team requesting data deletion
            </span>
          </li>
          <li>
            <strong>API Request:</strong>
            If you're using our API, you can delete your account programmatically
          </li>
        </ol>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">What Data Will Be Deleted</h2>
      <ul class="list-disc ps-6 space-y-2 text-muted">
        <li>Your account information (email, username, profile data)</li>
        <li>OAuth provider connections and associated data</li>
        <li>Any user-generated content or metadata</li>
        <li>Session and activity data</li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">What Data Cannot Be Deleted</h2>
      <ul class="list-disc ps-6 space-y-2 text-muted">
        <li>Data required for legal compliance or regulatory purposes</li>
        <li>Aggregated statistics that no longer identify you</li>
        <li>
          Backup data that may be retained for a limited time for recovery purposes
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Processing Time</h2>
      <p class="text-muted">
        Deleting your account in the app or through the API takes effect immediately. Requests sent
        to support are typically processed within 30 days, and we reply once the deletion is
        complete.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Contact Information</h2>
      <p :if={@contact_email} class="text-muted">
        If you have questions about the data deletion process or need assistance, email us at <a
          href={"mailto:" <> @contact_email}
          class="link link-primary"
        >{@contact_email}</a>.
      </p>
      <p :if={!@contact_email} class="text-muted">
        If you have questions about the data deletion process or need assistance, please contact
        us through the project's support channels.
      </p>
    </section>

    <div class="text-center pt-8 border-t border-base-300">
      <small class="text-xs text-muted">Last updated: September 2026</small>
    </div>
  </div>
</Layouts.app>
