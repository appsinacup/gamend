<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-center">
    <h1 class="mt-4 text-4xl font-black text-base-content/95">
      Terms and Conditions
    </h1>
    <p class="mt-4 leading-7 text-base-content/70 max-w-2xl mx-auto">
      These terms and conditions outline the rules and regulations for the use of our service.
    </p>
  </div>

  <div class="mt-12 max-w-4xl mx-auto space-y-8">
    <section>
      <h2 class="text-xl font-semibold mb-4">Acceptance of Terms</h2>
      <p class="text-base-content/80">
        By accessing and using this service, you accept and agree to be bound by the terms and
        provision of this agreement.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Use License</h2>
      <div class="space-y-4 text-base-content/80">
        <p>
          Permission is granted to use this hosted service for personal purposes. This license
          covers the service itself (your account, the servers, and the content we host), and
          under it you may not:
        </p>
        <ul class="list-disc ps-6 space-y-2">
          <li>Resell access to the service or misrepresent it as your own</li>
          <li>
            Probe, disrupt, or gain unauthorized access to the service or other users' accounts
          </li>
          <li>Remove any copyright or other proprietary notations from hosted content</li>
        </ul>
        <p>
          Open-source components and openly licensed content (such as MIT-licensed code and
          translation data) are governed by their own licenses, which this section does not
          restrict.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Fair Play</h2>
      <ul class="list-disc ps-6 space-y-2 text-base-content/80">
        <li>No cheating, exploiting bugs, or automating gameplay</li>
        <li>No harassment or abusive content in chat or user-generated content</li>
        <li>
          We may suspend or ban accounts and addresses that violate these rules to protect other
          players
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Virtual Goods</h2>
      <p class="text-base-content/80">
        In-game currency and cosmetic items have no monetary value, cannot be exchanged for real
        money, and may be adjusted, rebalanced, or discontinued as part of game updates. Purchases
        through platform stores are additionally subject to those stores' terms.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">User Accounts</h2>
      <ul class="list-disc ps-6 space-y-2 text-base-content/80">
        <li>
          You are responsible for maintaining the confidentiality of your account credentials
        </li>
        <li>
          You agree to accept responsibility for all activities that occur under your account
        </li>
        <li>You must notify us immediately of any unauthorized use of your account</li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Privacy</h2>
      <p class="text-base-content/80">
        Your privacy is important to us. Please review our Privacy Policy, which also governs your
        use of the service, to understand our practices.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Disclaimer</h2>
      <p class="text-base-content/80">
        The information on this service is provided on an 'as is' basis. To the fullest extent
        permitted by law, we exclude all representations, warranties, conditions and terms whether
        express or implied.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Limitations</h2>
      <p class="text-base-content/80">
        In no event shall we or our suppliers be liable for any damages (including, without
        limitation, damages for loss of data or profit, or due to business interruption) arising
        out of the use or inability to use the service.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-4">Contact Information</h2>
      <p class="text-base-content/80">
        If you have any questions about these Terms and Conditions, please contact us through the
        project's support channels.
      </p>
    </section>

    <div class="text-center pt-8 border-t border-base-300">
      <small class="text-xs text-base-content/60">Last updated: July 2026</small>
    </div>
  </div>
</Layouts.app>
