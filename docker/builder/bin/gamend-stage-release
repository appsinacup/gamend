#!/bin/sh
#
# Put beside an assembled release what it reads from the directory it starts
# in but does not carry: the theme, markdown content, docs and plugins, and a
# VERSION file. The runtime stage then copies the one directory.
#
#   RUN mix release --overwrite && gamend-stage-release my_app
#
# Each path is copied when the app has it, so one list serves every app:
# theme/, content/, blog/, priv/docs/, CHANGELOG.md, ROADMAP.md, modules/ (a
# host's theme config is modules/<app>_config.json) and
# $GAMEND_CONTENT_PLUGINS_DIR, less each plugin's own _build (a plugin loads
# from its bundle: ebin/, priv/, deps/*/ebin). Last, what the release
# declares, gamend-metadata.json (Gamend.Release.Metadata), for a host to read
# from the image without booting it; a Gamend before it writes none.
set -e

release=${1:?usage: gamend-stage-release <release name>}
dest="_build/${MIX_ENV:-prod}/rel/${release}"
plugins=${GAMEND_CONTENT_PLUGINS_DIR:-modules/plugins}

if [ ! -d "${dest}/bin" ]; then
  echo "No release at ${dest}: run mix release first, or pass the name it built" >&2
  exit 1
fi

case "$plugins" in
  modules/*) extra="" ;;
  *) extra=$plugins ;;
esac

for path in theme content blog priv/docs CHANGELOG.md ROADMAP.md modules $extra; do
  [ -e "$path" ] || continue
  mkdir -p "${dest}/$(dirname "$path")"
  rm -rf "${dest:?}/${path}"
  cp -a "$path" "${dest}/$(dirname "$path")/"
done

for dir in "${dest}/modules" "${dest}/${plugins}"; do
  [ -d "$dir" ] && find "$dir" -type d -name _build -prune -exec rm -rf {} +
done

if [ -n "${GAMEND_CONTENT_APP_VERSION:-}" ]; then
  printf %s "$GAMEND_CONTENT_APP_VERSION" > "${dest}/VERSION"
elif [ -f VERSION ]; then
  cp VERSION "${dest}/VERSION"
else
  git rev-parse --short HEAD > "${dest}/VERSION" 2>/dev/null || echo unknown > "${dest}/VERSION"
fi

# From the staged directory, as the image starts in it: the plugins it loads
# are the ones copied above. `eval` applies runtime.exs, which with no
# database configured picks SQLite, and a Postgres build's Repo refuses to
# boot on that (its adapter is compile time): an address for it, never
# dialled, as eval starts nothing. A write that fails leaves the image
# without the file, which a host reports, rather than failing the build: a
# host app's runtime.exs may want what only its deploy sets.
if [ "${GAMEND_DB_ADAPTER:-}" = postgres ] && [ -z "${GAMEND_DB_URL:-}" ]; then
  export GAMEND_DB_URL=ecto://metadata@localhost/metadata
fi

if ! (cd "$dest" && "bin/${release}" eval \
  'if Code.ensure_loaded?(Gamend.Release.Metadata), do: Gamend.Release.Metadata.write()'); then
  rm -f "${dest}/gamend-metadata.json"
  echo "warning: could not write gamend-metadata.json; the image lists no settings" >&2
fi
