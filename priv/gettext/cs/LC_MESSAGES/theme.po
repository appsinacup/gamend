msgstr "Přihlásit se"

msgid "Register"
msgstr "Registrovat se"

msgid "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email."
msgstr "E-mail, magický odkaz, OAuth, JWT a relace. Registrace, přihlášení, obnovení hesla a ověření e-mailu."

msgid "Authentication & Users"
msgstr "Ověřování a uživatelé"

msgid "Real-time lobbies and ephemeral parties. Customizable settings with live updates."
msgstr "Realtimové lobby a dočasné party. Přizpůsobitelná nastavení se živými aktualizacemi."

msgid "Lobbies, Parties & Matchmaking"
msgstr "Lobby, party a hledání hry"

msgid "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging."
msgstr "Žádosti o přátelství, blokování, přítomnost v reálném čase. Veřejné, soukromé a skryté skupiny. Přímé a skupinové zprávy."

msgid "Friends, Groups & Chat"
msgstr "Přátelé, skupiny a chat"

msgid "Server-authoritative achievements, bracket tournaments and leaderboards. Real-time notifications across features and payment events."
msgstr "Úspěchy, vyřazovací turnaje a žebříčky vyhodnocované serverem. Oznámení v reálném čase napříč funkcemi i platebními událostmi."

msgid "Achievements, Tournaments, Leaderboards & Notifications"
msgstr "Úspěchy, turnaje, žebříčky a oznámení"

msgid "Extend server logic with Elixir scripts. Schedule automated tasks and cron jobs."
msgstr "Rozšiřte logiku serveru skripty v Elixiru. Naplánujte automatické úlohy a úlohy cron."

msgid "Server Scripting & Scheduling"
msgstr "Serverové skripty a plánování"

msgid "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels. Admin portal and web UI."
msgstr "REST API, realtimové kanály WebSocket a WebRTC DataChannels s nízkou latencí. Administrační portál a webové rozhraní."

msgid "HTTP, WebSocket & WebRTC"
msgstr "HTTP, WebSocket a WebRTC"

msgid "Open Store"
msgstr "Otevřít obchod"

msgid "Payment Docs"
msgstr "Dokumentace plateb"

msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Platby na straně serveru přes Stripe, Google Play, App Store a Steam. Ověřujte účtenky, zpracovávejte podepsané webhooky, přidělujte oprávnění, rušte vrácené platby a vše si prohlédněte ve správě."

msgid "Payments & Store Integrations"
msgstr "Platby a integrace obchodů"

