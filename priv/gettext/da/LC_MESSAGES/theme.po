msgid "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email."
msgstr "E-mail, magisk link, OAuth, JWT og session. Oprettelse, login, nulstilling af adgangskode og e-mailbekræftelse."

msgid "Authentication & Users"
msgstr "Godkendelse og brugere"

msgid "Real-time lobbies and ephemeral parties. Customizable settings with live updates."
msgstr "Lobbyer i realtid og midlertidige selskaber. Indstillinger, der kan tilpasses med liveopdateringer."

msgid "Lobbies, Parties & Matchmaking"
msgstr "Lobbyer, selskaber og matchmaking"

msgid "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging."
msgstr "Venneanmodninger, blokering, tilstedeværelse i realtid. Offentlige, private og skjulte grupper. Direkte beskeder og gruppebeskeder."

msgid "Friends, Groups & Chat"
msgstr "Venner, grupper og chat"

msgid "Server-authoritative achievements, bracket tournaments and leaderboards. Real-time notifications across features and payment events."
msgstr "Serverbestemte præstationer, cupturneringer og ranglister. Notifikationer i realtid på tværs af funktioner og betalingshændelser."

msgid "Achievements, Tournaments, Leaderboards & Notifications"
msgstr "Præstationer, turneringer, ranglister og notifikationer"

msgid "Extend server logic with Elixir scripts. Schedule automated tasks and cron jobs."
msgstr "Udvid serverlogikken med Elixir-scripts. Planlæg automatiske opgaver og cron-job."

msgid "Server Scripting & Scheduling"
msgstr "Serverscripts og planlægning"

msgid "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels. Admin portal and web UI."
msgstr "REST-API, WebSocket-kanaler i realtid og WebRTC-datakanaler med lav latenstid. Adminportal og webgrænseflade."

msgid "HTTP, WebSocket & WebRTC"
msgstr "HTTP, WebSocket og WebRTC"

msgid "Open Store"
msgstr "Åbn butikken"

msgid "Payment Docs"
msgstr "Betalingsdokumentation"

msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Betalinger på serversiden med Stripe, Google Play, App Store og Steam. Validér kvitteringer, behandl signerede webhooks, tildel rettigheder, tilbagekald refusioner og se det hele i administrationen."

msgid "Payments & Store Integrations"
msgstr "Betalinger og butiksintegrationer"

