msgid "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email."
msgstr "Email, magic link, OAuth, JWT και συνεδρία. Εγγραφή, σύνδεση, επαναφορά κωδικού και επαλήθευση email."

msgid "Authentication & Users"
msgstr "Αυθεντικοποίηση & Χρήστες"

msgid "Real-time lobbies and ephemeral parties. Customizable settings with live updates."
msgstr "Αίθουσες αναμονής και προσωρινές ομάδες. Τροποποιήσιμες ρυθμίσεις με ζωντανές ενημερώσεις"

msgid "Lobbies, Parties & Matchmaking"
msgstr "Λόμπι, παρέες και αντιστοίχιση παικτών"

msgid "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging."
msgstr "Αιτήματα φιλίας, αποκλεισμοί, ζωντανή συνδεσιμότητα. Δημόσια, ιδιωτικά, κρυμμένες ομάδες. Άμεσες ή ομαδικές συνομιλίες."

msgid "Friends, Groups & Chat"
msgstr "Φίλοι, Ομάδες & Συνομιλίες"

msgid "Server-authoritative achievements, bracket tournaments and leaderboards. Real-time notifications across features and payment events."
msgstr "Επιτεύγματα, τουρνουά νοκ άουτ και βαθμολογίες που επικυρώνει ο διακομιστής. Ειδοποιήσεις σε πραγματικό χρόνο για όλες τις λειτουργίες και τα συμβάντα πληρωμών."

msgid "Achievements, Tournaments, Leaderboards & Notifications"
msgstr "Επιτεύγματα, Τουρνουά, Πίνακες Κατάταξης & Ειδοποιήσεις"

msgid "Extend server logic with Elixir scripts. Schedule automated tasks and cron jobs."
msgstr "Επεκτείνετε τη λογική του διακομιστή με σενάρια Elixir. Προγραμματίστε αυτόματες εργασίες και εργασίες cron."

msgid "Server Scripting & Scheduling"
msgstr "Σενάρια διακομιστή και χρονοπρογραμματισμός"

msgid "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels. Admin portal and web UI."
msgstr "REST API, κανάλια WebSocket σε πραγματικό χρόνο και WebRTC DataChannels χαμηλής καθυστέρησης. Πύλη διαχείρισης και διαδικτυακό περιβάλλον."

msgid "HTTP, WebSocket & WebRTC"
msgstr "HTTP, WebSocket και WebRTC"

msgid "Open Store"
msgstr "Άνοιγμα καταστήματος"

msgid "Payment Docs"
msgstr "Τεκμηρίωση πληρωμών"

msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Πληρωμές από την πλευρά του διακομιστή με Stripe, Google Play, App Store και Steam. Επικυρώστε αποδείξεις, επεξεργαστείτε υπογεγραμμένα webhooks, παραχωρήστε δικαιώματα, ανακαλέστε επιστροφές χρημάτων και ελέγξτε τα πάντα από τη διαχείριση."

msgid "Payments & Store Integrations"
msgstr "Πληρωμές και ενσωματώσεις καταστημάτων"

