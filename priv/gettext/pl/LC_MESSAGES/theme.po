msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Płatności po stronie serwera z użyciem Stripe, Google Play, App Store i Steam. Weryfikuj paragony, obsługuj podpisane webhooki, przyznawaj uprawnienia, cofaj zwroty i sprawdzaj wszystko w panelu."

msgid "Payments & Store Integrations"
msgstr "Płatności i integracje ze sklepami"

