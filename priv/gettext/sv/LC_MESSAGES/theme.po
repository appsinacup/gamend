msgid "Gamend is a **batteries-included** Elixir backend for multiplayer games, with auth, social systems, real-time channels, and admin tooling."
msgstr "Gamend är en **komplett** Elixir-backend för flerspelarspel, med autentisering, sociala system, realtidskanaler och administrationsverktyg."

msgid "Realtime Guide"
msgstr "Realtidsguide"

msgid "Real-time games"
msgstr "Realtidsspel"

msgid "Use channels, lobbies, parties, presence, and WebRTC data channels without rebuilding common multiplayer infrastructure."
msgstr "Använd kanaler, lobbyer, sällskap, närvaro och WebRTC-datakanaler utan att bygga om den vanliga flerspelarinfrastrukturen."

msgid "Built For Real-Time Games"
msgstr "Byggd för realtidsspel"

msgid "Read Docs"
msgstr "Läs dokumentationen"

msgid "Open source foundation"
msgstr "Grund i öppen källkod"

msgid "The project is designed to be forked, themed, hosted, and extended by game teams."
msgstr "Projektet är gjort för att spelteam ska kunna forka, tematisera, drifta och bygga vidare på det."

msgid "Open Source Foundation"
msgstr "Grund i öppen källkod"

msgid "Getting Started"
msgstr "Kom igång"

msgid "Presentation Video"
msgstr "Presentationsvideo"

msgid "**Open source** Elixir game server for **real-time** multiplayer games."
msgstr "**Öppen källkod** – en Elixir-spelserver för **realtidsbaserade** flerspelarspel."

msgid "Log in"
msgstr "Logga in"

msgid "Register"
msgstr "Registrera"

msgid "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email."
msgstr "E-post, magisk länk, OAuth, JWT och session. Registrering, inloggning, återställning av lösenord och e-postverifiering."

msgid "Authentication & Users"
msgstr "Autentisering och användare"

msgid "Real-time lobbies and ephemeral parties. Customizable settings with live updates."
msgstr "Lobbyer i realtid och tillfälliga sällskap. Anpassningsbara inställningar med liveuppdateringar."

msgid "Lobbies, Parties & Matchmaking"
msgstr "Lobbyer, sällskap och matchmaking"

msgid "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging."
msgstr "Vänförfrågningar, blockering, närvaro i realtid. Öppna, privata och dolda grupper. Direkt- och gruppmeddelanden."

msgid "Friends, Groups & Chat"
msgstr "Vänner, grupper och chatt"

msgid "Server-authoritative achievements, bracket tournaments and leaderboards. Real-time notifications across features and payment events."
msgstr "Serververifierade prestationer, utslagsturneringar och topplistor. Aviseringar i realtid för alla funktioner och betalningshändelser."

msgid "Achievements, Tournaments, Leaderboards & Notifications"
msgstr "Prestationer, turneringar, topplistor och aviseringar"

msgid "Extend server logic with Elixir scripts. Schedule automated tasks and cron jobs."
msgstr "Utöka serverlogiken med Elixir-skript. Schemalägg automatiska uppgifter och cron-jobb."

msgid "Server Scripting & Scheduling"
msgstr "Serverskript och schemaläggning"

msgid "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels. Admin portal and web UI."
msgstr "REST-API, WebSocket-kanaler i realtid och WebRTC-datakanaler med låg latens. Adminportal och webbgränssnitt."

msgid "HTTP, WebSocket & WebRTC"
msgstr "HTTP, WebSocket och WebRTC"

msgid "Open Store"
msgstr "Öppna butiken"

msgid "Payment Docs"
msgstr "Betalningsdokumentation"

msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Serverbaserade betalningar med Stripe, Google Play, App Store och Steam. Validera kvitton, hantera signerade webhooks, bevilja rättigheter, återkalla återbetalningar och granska allt i adminvyn."

msgid "Payments & Store Integrations"
msgstr "Betalningar och butiksintegrationer"

msgid "Gamend is in beta!"
msgstr "Gamend är i beta!"

msgid "Game + Backend"
msgstr "Spel + backend"
