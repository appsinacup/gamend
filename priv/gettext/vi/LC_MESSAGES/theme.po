msgid "**Open source** Elixir game server for **real-time** multiplayer games."
msgstr "Máy chủ game Elixir **mã nguồn mở** cho các trò chơi nhiều người **thời gian thực**."

msgid "Log in"
msgstr "Đăng nhập"

msgid "Register"
msgstr "Đăng ký"

msgid "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email."
msgstr "Email, liên kết đăng nhập nhanh, OAuth, JWT và phiên. Đăng ký, đăng nhập, đặt lại mật khẩu và xác minh email."

msgid "Authentication & Users"
msgstr "Xác thực và người dùng"

msgid "Real-time lobbies and ephemeral parties. Customizable settings with live updates."
msgstr "Sảnh chờ thời gian thực và nhóm chơi tạm thời. Cài đặt tùy chỉnh với cập nhật trực tiếp."

msgid "Lobbies, Parties & Matchmaking"
msgstr "Sảnh chờ, nhóm chơi và ghép trận"

msgid "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging."
msgstr "Lời mời kết bạn, chặn, trạng thái trực tuyến thời gian thực. Nhóm công khai, riêng tư và ẩn. Nhắn tin riêng và nhóm."

msgid "Friends, Groups & Chat"
msgstr "Bạn bè, nhóm và trò chuyện"

msgid "Server-authoritative achievements, bracket tournaments and leaderboards. Real-time notifications across features and payment events."
msgstr "Thành tựu, giải đấu loại trực tiếp và bảng xếp hạng do máy chủ xác thực. Thông báo thời gian thực cho mọi tính năng và sự kiện thanh toán."

msgid "Achievements, Tournaments, Leaderboards & Notifications"
msgstr "Thành tựu, giải đấu, bảng xếp hạng và thông báo"

msgid "Extend server logic with Elixir scripts. Schedule automated tasks and cron jobs."
msgstr "Mở rộng logic máy chủ bằng script Elixir. Lên lịch tác vụ tự động và tác vụ cron."

msgid "Server Scripting & Scheduling"
msgstr "Script máy chủ và lập lịch"

msgid "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels. Admin portal and web UI."
msgstr "REST API, kênh WebSocket thời gian thực và DataChannel WebRTC độ trễ thấp. Cổng quản trị và giao diện web."

msgid "HTTP, WebSocket & WebRTC"
msgstr "HTTP, WebSocket và WebRTC"

msgid "Open Store"
msgstr "Mở cửa hàng"

msgid "Payment Docs"
msgstr "Tài liệu thanh toán"

msgid "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin."
msgstr "Thanh toán phía máy chủ với Stripe, Google Play, App Store và Steam. Xác thực biên lai, xử lý webhook có chữ ký, cấp quyền lợi, thu hồi khoản hoàn tiền và xem lại tất cả trong trang quản trị."

msgid "Payments & Store Integrations"
msgstr "Thanh toán và tích hợp cửa hàng"

msgid "Game + Backend"
msgstr "Game + backend"
