      "sections_height": "half",
      "sections": [
        {
          "title": "What is Gamend?",
          "text": "The **backend for your multiplayer game**: accounts, lobbies, chat, leaderboards and everything players expect around the game itself. It also ships the web UI around it, a ready-made player website (store, leaderboards, tournaments, quests, groups, chat) and a full admin panel. Server-side scripting runs your own logic where players cannot reach it. You run it on your own server; there is no hosted service.",
          "image": {
            "light": "/images/banner.webp",
            "alt": "Gamend",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-question-mark-circle-solid",
          "media_width": "third",
          "image_position_desktop": "right",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Benchmarks",
              "href": "/docs/performance",
              "icon": "hero-chart-bar-solid"
            },
            {
              "label": "Godot SDK",
              "href": "/docs/godot-sdk",
              "icon": "hero-puzzle-piece-solid"
            }
          ]
        },
        {
          "title": "Authentication & Users",
          "text": "Email, Magic-link, OAuth, JWT and Session. Register, login, reset password and verify email.",
          "image": {
            "light": "/images/screenshots/login-light.webp",
            "dark": "/images/screenshots/login-dark.webp",
            "alt": "The login page with magic link, password and five OAuth providers",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-lock-closed-solid",
          "media_width": "third",
          "image_position_desktop": "left",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Log in",
              "href": "/users/log_in",
              "icon": "hero-arrow-right-on-rectangle-solid"
            },
            {
              "label": "Register",
              "href": "/users/register",
              "icon": "hero-user-plus-solid"
            }
          ]
        },
        {
          "title": "Lobbies, Parties & Matchmaking",
          "text": "Real-time lobbies with passwords, quick join and live updates. Ephemeral parties that join and get matched **as one unit**, a ticket-queue matchmaker and ready checks before anything starts.",
          "image": {
            "light": "/images/screenshots/admin-matchmaking-light.webp",
            "dark": "/images/screenshots/admin-matchmaking-dark.webp",
            "alt": "The matchmaking admin page with live queues, tickets and ready checks",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-home-solid",
          "media_width": "third",
          "image_position_desktop": "right",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Lobbies",
              "href": "/docs/lobbies",
              "icon": "hero-book-open-solid"
            },
            {
              "label": "Matchmaking",
              "href": "/docs/matchmaking",
              "icon": "hero-bolt-solid"
            }
          ]
        },
        {
          "title": "Friends, Groups & Chat",
          "text": "Friend requests, blocking, real-time presence. Public, private and hidden groups. Direct and group messaging.",
          "image": {
            "light": "/images/screenshots/groups-light.webp",
            "dark": "/images/screenshots/groups-dark.webp",
            "alt": "The public groups browser",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-user-group-solid",
          "media_width": "third",
          "image_position_desktop": "left",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Groups",
              "href": "/groups",
              "icon": "hero-user-group-solid"
            }
          ]
        },
        {
          "title": "Quests, Tournaments & Leaderboards",
          "text": "One server-authoritative quest engine for achievements, dailies, seasonal events and quest chains. Bracket tournaments, leaderboards with seasons, and real-time plus push notifications across every feature.",
          "image": {
            "light": "/images/screenshots/quests-light.webp",
            "dark": "/images/screenshots/quests-dark.webp",
            "alt": "The quests page with daily, achievement and event quests",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-trophy-solid",
          "media_width": "third",
          "image_position_desktop": "right",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Quests",
              "href": "/quests",
              "icon": "hero-trophy-solid"
            },
            {
              "label": "Tournaments",
              "href": "/tournaments",
              "icon": "hero-bolt-solid"
            },
            {
              "label": "Leaderboards",
              "href": "/leaderboards",
              "icon": "hero-chart-bar-solid"
            }
          ]
        },
        {
          "title": "Server Scripting & Scheduling",
          "text": "Write server hooks in **Elixir, GDScript or Gleam** for scoring, rewards, matchmaking rules and validation, where players cannot reach them. Durable background jobs and cron scheduling built in.",
          "image": {
            "light": "/images/screenshots/admin-runtime-light.webp",
            "dark": "/images/screenshots/admin-runtime-dark.webp",
            "alt": "Runtime introspection listing every hook with its implementing plugins",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-puzzle-piece-solid",
          "media_width": "third",
          "image_position_desktop": "left",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Server Scripting",
              "href": "/docs/server-scripting",
              "icon": "hero-academic-cap-solid"
            },
            {
              "label": "GDScript Hooks",
              "href": "/docs/gdscript-hooks",
              "icon": "hero-puzzle-piece-solid"
            }
          ]
        },
        {
          "title": "HTTP, WebSocket & WebRTC",
          "text": "REST API, real-time WebSocket channels and low-latency WebRTC DataChannels, with an opt-in protobuf realtime format. Admin portal and web UI, translated into 30 languages.",
          "icon": "hero-globe-alt-solid",
          "media_width": "third",
          "image_position_desktop": "right",
          "image_position_mobile": "top",
          "text_align": "left"
        },
        {
          "title": "Payments & Store Integrations",
          "text": "Server-side payments with Stripe, Google Play, App Store, and Steam providers. Validate receipts, process signed webhooks, grant entitlements, revoke refunds, and inspect everything in admin.",
          "image": {
            "light": "/images/screenshots/store-light.webp",
            "dark": "/images/screenshots/store-dark.webp",
            "alt": "The built-in store page with priced products",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-credit-card-solid",
          "media_width": "third",
          "image_position_desktop": "left",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Open Store",
              "href": "/store",
              "icon": "hero-shopping-bag-solid"
            },
            {
              "label": "Payment Docs",
              "href": "/docs/payments",
              "icon": "hero-book-open-solid"
            }
          ]
        },
        {
          "title": "Economy, Inventory & Storage",
          "text": "Virtual currency wallets with an atomic, append-only ledger. Item stacks with grant and consume. A per-player and per-lobby **key-value store**, and object storage with presigned uploads on local disk or any S3-compatible backend.",
          "image": {
            "light": "/images/screenshots/admin-economy-light.webp",
            "dark": "/images/screenshots/admin-economy-dark.webp",
            "alt": "The economy admin page with wallets and grant and spend controls",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-banknotes-solid",
          "media_width": "third",
          "image_position_desktop": "right",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Economy",
              "href": "/docs/economy",
              "icon": "hero-banknotes-solid"
            },
            {
              "label": "Key-Value Store",
              "href": "/docs/key-value",
              "icon": "hero-circle-stack-solid"
            }
          ]
        },
        {
          "title": "Analytics, Logs & Observability",
          "text": "D1 / D7 / D30 retention, DAU and payer conversion built in. Client log sessions correlated with the server's own tail for per-player debugging. Prometheus metrics with Grafana, and a load-test harness with published benchmarks.",
          "image": {
            "light": "/images/screenshots/admin-analytics-light.webp",
            "dark": "/images/screenshots/admin-analytics-dark.webp",
            "alt": "The analytics admin page with DAU and D1, D7 and D30 retention",
            "widths": [
              480,
              960
            ]
          },
          "icon": "hero-chart-bar-solid",
          "media_width": "third",
          "image_position_desktop": "left",
          "image_position_mobile": "top",
          "text_align": "left",
          "buttons": [
            {
              "label": "Player Analytics",
              "href": "/docs/player-analytics",
              "icon": "hero-chart-bar-solid"
            },
            {
              "label": "Client Logs",
              "href": "/docs/client-logs",
              "icon": "hero-document-text-solid"
            }
          ]
        }
      ]
    }
  },
