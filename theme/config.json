          "src": "/images/hero-tour.mp4",
          "poster": "/images/hero-tour-poster.webp",
          "alt": "A tour of the Gamend admin panel, quests, store and server hooks",
          "width": 1280,
          "height": 800,
          "preload": "none"
        },
        "image_position_desktop": "left",
        "image_position_mobile": "top",
        "media_width": "half",
        "media_size": "section",
        "text_align": "center",
        "buttons": [
          {
            "label": "Getting Started",
            "href": "/docs/deployment",
